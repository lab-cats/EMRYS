{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:norad:schema:artifacts:scientific-review-record:v1",
  "title": "NORAD scientific review record v1",
  "description": "A normalized record of an explicit Step 09c scientific review. This version rejects biological_interpretation_ready.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "record_type",
    "run_id",
    "run_contract",
    "review_id",
    "primary_analysis_id",
    "superseded_analysis_ids",
    "sensitivity_analysis_ids",
    "review_metadata",
    "computational_status",
    "scientific_state",
    "readiness_authorization",
    "policy_versions",
    "selection_rules",
    "evidence_categories",
    "evidence_records",
    "decisions",
    "input_artifacts",
    "review_summary",
    "limitations",
    "warnings",
    "errors",
    "provenance"
  ],
  "properties": {
    "schema_name": {
      "const": "norad.scientific_review_record"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "record_type": {
      "const": "scientific_review_record"
    },
    "run_id": {
      "$ref": "urn:norad:schema:artifacts:common:v1#/$defs/safe_id"
    },
    "run_contract": {
      "$ref": "urn:norad:schema:artifacts:common:v1#/$defs/run_contract"
    },
    "review_id": {
      "$ref": "urn:norad:schema:artifacts:common:v1#/$defs/safe_id"
    },
    "primary_analysis_id": {
      "$ref": "urn:norad:schema:artifacts:common:v1#/$defs/safe_id"
    },
    "superseded_analysis_ids": {
      "type": "array",
      "items": {
        "$ref": "urn:norad:schema:artifacts:common:v1#/$defs/safe_id"
      },
      "uniqueItems": true
    },
    "sensitivity_analysis_ids": {
      "type": "array",
      "items": {
        "$ref": "urn:norad:schema:artifacts:common:v1#/$defs/safe_id"
      },
      "uniqueItems": true
    },
    "review_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan_version",
        "plan_date",
        "reviewer",
        "decision_owner",
        "git_commit",
        "review_completed_date"
      ],
      "properties": {
        "plan_version": {
          "$ref": "urn:norad:schema:artifacts:common:v1#/$defs/safe_id"
        },
        "plan_date": {
          "type": "string",
          "format": "date"
        },
        "reviewer": {
          "$ref": "urn:norad:schema:artifacts:common:v1#/$defs/safe_id"
        },
        "decision_owner": {
          "$ref": "urn:norad:schema:artifacts:common:v1#/$defs/safe_id"
        },
        "git_commit": {
          "$ref": "urn:norad:schema:artifacts:common:v1#/$defs/git_commit"
        },
        "review_completed_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        }
      }
    },
    "computational_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation_status",
        "local_test_status",
        "runtime_validation_status",
        "cluster_dry_run_status",
        "cluster_proof_status",
        "evidence"
      ],
      "properties": {
        "implementation_status": {
          "enum": [
            "not_implemented",
            "implemented"
          ]
        },
        "local_test_status": {
          "enum": [
            "not_run",
            "passed",
            "failed"
          ]
        },
        "runtime_validation_status": {
          "enum": [
            "not_run",
            "blocked",
            "passed",
            "failed"
          ]
        },
        "cluster_dry_run_status": {
          "enum": [
            "not_run",
            "passed",
            "failed"
          ]
        },
        "cluster_proof_status": {
          "enum": [
            "not_run",
            "proven",
            "failed"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "urn:norad:schema:artifacts:common:v1#/$defs/evidence_reference"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "cluster_proof_status": {
                "const": "proven"
              }
            },
            "required": [
              "cluster_proof_status"
            ]
          },
          "then": {
            "properties": {
              "cluster_dry_run_status": {
                "const": "passed"
              }
            }
          }
        },
        {
          "if": {
            "anyOf": [
              {
                "properties": {
                  "cluster_dry_run_status": {
                    "const": "passed"
                  }
                },
                "required": [
                  "cluster_dry_run_status"
                ]
              },
              {
                "properties": {
                  "cluster_proof_status": {
                    "const": "proven"
                  }
                },
                "required": [
                  "cluster_proof_status"
                ]
              }
            ]
          },
          "then": {
            "properties": {
              "evidence": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "scientific_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overall_status",
        "orientation_status",
        "orientation_policy",
        "orientation_policy_version"
      ],
      "properties": {
        "overall_status": {
          "enum": [
            "evidence_incomplete",
            "science_review_complete_exploratory"
          ]
        },
        "orientation_status": {
          "enum": [
            "provisional",
            "validated",
            "replacement_required"
          ]
        },
        "orientation_policy": {
          "$ref": "urn:norad:schema:artifacts:common:v1#/$defs/safe_id"
        },
        "orientation_policy_version": {
          "$ref": "urn:norad:schema:artifacts:common:v1#/$defs/safe_id"
        }
      }
    },
    "readiness_authorization": {
      "type": "null"
    },
    "policy_versions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locus_selection",
        "candidate_selection",
        "sensitivity",
        "background",
        "annotation",
        "adjudication"
      ],
      "properties": {
        "locus_selection": {
          "$ref": "urn:norad:schema:artifacts:common:v1#/$defs/safe_id"
        },
        "candidate_selection": {
          "$ref": "urn:norad:schema:artifacts:common:v1#/$defs/safe_id"
        },
        "sensitivity": {
          "$ref": "urn:norad:schema:artifacts:common:v1#/$defs/safe_id"
        },
        "background": {
          "$ref": "urn:norad:schema:artifacts:common:v1#/$defs/safe_id"
        },
        "annotation": {
          "$ref": "urn:norad:schema:artifacts:common:v1#/$defs/safe_id"
        },
        "adjudication": {
          "$ref": "urn:norad:schema:artifacts:common:v1#/$defs/safe_id"
        }
      }
    },
    "selection_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locus_selection",
        "candidate_selection",
        "sensitivity",
        "leave_one_pair_out"
      ],
      "properties": {
        "locus_selection": {
          "$ref": "urn:norad:schema:artifacts:common:v1#/$defs/non_empty_string"
        },
        "candidate_selection": {
          "$ref": "urn:norad:schema:artifacts:common:v1#/$defs/non_empty_string"
        },
        "sensitivity": {
          "$ref": "urn:norad:schema:artifacts:common:v1#/$defs/non_empty_string"
        },
        "leave_one_pair_out": {
          "$ref": "urn:norad:schema:artifacts:common:v1#/$defs/non_empty_string"
        }
      }
    },
    "evidence_categories": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orientation_locus_audit",
        "annotation_audit",
        "qc_funnel",
        "replicate_effects",
        "sensitivity_matrix",
        "leave_one_pair_out",
        "candidate_selection",
        "candidate_adjudication",
        "decisions",
        "limitations"
      ],
      "properties": {
        "orientation_locus_audit": {
          "$ref": "#/$defs/evidence_category"
        },
        "annotation_audit": {
          "$ref": "#/$defs/evidence_category"
        },
        "qc_funnel": {
          "$ref": "#/$defs/evidence_category"
        },
        "replicate_effects": {
          "$ref": "#/$defs/evidence_category"
        },
        "sensitivity_matrix": {
          "$ref": "#/$defs/evidence_category"
        },
        "leave_one_pair_out": {
          "$ref": "#/$defs/evidence_category"
        },
        "candidate_selection": {
          "$ref": "#/$defs/evidence_category"
        },
        "candidate_adjudication": {
          "$ref": "#/$defs/evidence_category"
        },
        "decisions": {
          "$ref": "#/$defs/evidence_category"
        },
        "limitations": {
          "$ref": "#/$defs/evidence_category"
        }
      }
    },
    "evidence_records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence_record"
      }
    },
    "decisions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orientation",
        "annotation",
        "thresholds",
        "background",
        "matched_dna",
        "orthogonal_evidence",
        "adjudication"
      ],
      "properties": {
        "orientation": {
          "$ref": "#/$defs/decision"
        },
        "annotation": {
          "$ref": "#/$defs/decision"
        },
        "thresholds": {
          "$ref": "#/$defs/decision"
        },
        "background": {
          "$ref": "#/$defs/decision"
        },
        "matched_dna": {
          "$ref": "#/$defs/decision"
        },
        "orthogonal_evidence": {
          "$ref": "#/$defs/decision"
        },
        "adjudication": {
          "$ref": "#/$defs/decision"
        }
      }
    },
    "input_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/input_artifact"
      }
    },
    "review_summary": {
      "allOf": [
        {
          "$ref": "urn:norad:schema:artifacts:common:v1#/$defs/path_hash"
        },
        {
          "properties": {
            "row_count": {
              "const": 1
            }
          },
          "required": [
            "row_count"
          ]
        }
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "$ref": "urn:norad:schema:artifacts:common:v1#/$defs/limitation"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "urn:norad:schema:artifacts:common:v1#/$defs/issue"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "urn:norad:schema:artifacts:common:v1#/$defs/issue"
      }
    },
    "provenance": {
      "$ref": "urn:norad:schema:artifacts:common:v1#/$defs/provenance"
    }
  },
  "$defs": {
    "evidence_category": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "evidence_ids",
        "not_applicable_reason"
      ],
      "properties": {
        "status": {
          "enum": [
            "missing",
            "incomplete",
            "complete",
            "not_applicable"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "$ref": "urn:norad:schema:artifacts:common:v1#/$defs/safe_id"
          },
          "uniqueItems": true
        },
        "not_applicable_reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "not_applicable"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "not_applicable_reason": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "else": {
            "properties": {
              "not_applicable_reason": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "complete",
                  "incomplete"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "evidence_ids": {
                "minItems": 1
              }
            }
      }
    }
      ]
    },
    "evidence_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "category",
        "analysis_id",
        "status",
        "source",
        "reviewer",
        "owner",
        "evidence_date",
        "policy_version",
        "not_applicable_reason"
      ],
      "properties": {
        "evidence_id": {
          "$ref": "urn:norad:schema:artifacts:common:v1#/$defs/safe_id"
        },
        "category": {
          "enum": [
            "orientation_locus_audit",
            "annotation_audit",
            "qc_funnel",
            "replicate_effects",
            "sensitivity_matrix",
            "leave_one_pair_out",
            "candidate_selection",
            "candidate_adjudication",
            "decisions",
            "limitations",
            "computational_validation"
          ]
        },
        "analysis_id": {
          "$ref": "urn:norad:schema:artifacts:common:v1#/$defs/safe_id"
        },
        "status": {
          "enum": [
            "missing",
            "incomplete",
            "complete",
            "not_applicable"
          ]
        },
        "source": {
          "oneOf": [
            {
              "$ref": "urn:norad:schema:artifacts:common:v1#/$defs/path_hash"
            },
            {
              "type": "null"
            }
          ]
        },
        "reviewer": {
          "$ref": "urn:norad:schema:artifacts:common:v1#/$defs/safe_id"
        },
        "owner": {
          "$ref": "urn:norad:schema:artifacts:common:v1#/$defs/safe_id"
        },
        "evidence_date": {
          "type": "string",
          "format": "date"
        },
        "policy_version": {
          "$ref": "urn:norad:schema:artifacts:common:v1#/$defs/safe_id"
        },
        "not_applicable_reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "complete",
                  "incomplete"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "source": {
                "$ref": "urn:norad:schema:artifacts:common:v1#/$defs/path_hash"
              },
              "not_applicable_reason": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "missing",
                  "not_applicable"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "source": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "not_applicable"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "not_applicable_reason": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "else": {
            "properties": {
              "not_applicable_reason": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "value",
        "detail",
        "reviewer",
        "decision_date",
        "evidence_ids",
        "rerun_scope"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "recorded"
          ]
        },
        "value": {
          "type": [
            "string",
            "null"
          ]
        },
        "detail": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewer": {
          "oneOf": [
            {
              "$ref": "urn:norad:schema:artifacts:common:v1#/$defs/safe_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "decision_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "$ref": "urn:norad:schema:artifacts:common:v1#/$defs/safe_id"
          },
          "uniqueItems": true
        },
        "rerun_scope": {
          "enum": [
            "none",
            "step09",
            "steps08_09",
            "steps07_09",
            "upstream_impact_review",
            "manual_only"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "recorded"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "minLength": 1
              },
              "detail": {
                "type": "string",
                "minLength": 1
              },
              "reviewer": {
                "$ref": "urn:norad:schema:artifacts:common:v1#/$defs/safe_id"
              },
              "decision_date": {
                "type": "string",
                "format": "date"
              }
            }
          },
          "else": {
            "properties": {
              "value": {
                "type": "null"
              },
              "detail": {
                "type": "null"
              },
              "reviewer": {
                "type": "null"
              },
              "decision_date": {
                "type": "null"
              },
              "evidence_ids": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "input_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "artifact_id",
        "path",
        "sha256",
        "row_count"
      ],
      "properties": {
        "role": {
          "enum": [
            "sample_manifest",
            "partition_manifest",
            "step08_sites",
            "step08_inputs",
            "step08_summary",
            "step09_all_sites",
            "step09_significant_sites",
            "step09_summary",
            "step09_mutation_spectrum_tsv",
            "step09_mutation_spectrum_pdf",
            "step09_depth_delta_pdf",
            "review_plan",
            "evidence_manifest"
          ]
        },
        "artifact_id": {
          "$ref": "urn:norad:schema:artifacts:common:v1#/$defs/safe_id"
        },
        "path": {
          "$ref": "urn:norad:schema:artifacts:common:v1#/$defs/path"
        },
        "sha256": {
          "$ref": "urn:norad:schema:artifacts:common:v1#/$defs/sha256"
        },
        "row_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "scientific_state": {
            "properties": {
              "overall_status": {
                "enum": [
                  "science_review_complete_exploratory"
                ]
              }
            },
            "required": [
              "overall_status"
            ]
          }
        },
        "required": [
          "scientific_state"
        ]
      },
      "then": {
        "properties": {
          "evidence_categories": {
            "properties": {
              "orientation_locus_audit": {
                "properties": {
                  "status": {
                    "enum": [
                      "complete",
                      "not_applicable"
                    ]
                  }
                }
              },
              "annotation_audit": {
                "properties": {
                  "status": {
                    "enum": [
                      "complete",
                      "not_applicable"
                    ]
                  }
                }
              },
              "qc_funnel": {
                "properties": {
                  "status": {
                    "enum": [
                      "complete",
                      "not_applicable"
                    ]
                  }
                }
              },
              "replicate_effects": {
                "properties": {
                  "status": {
                    "enum": [
                      "complete",
                      "not_applicable"
                    ]
                  }
                }
              },
              "sensitivity_matrix": {
                "properties": {
                  "status": {
                    "enum": [
                      "complete",
                      "not_applicable"
                    ]
                  }
                }
              },
              "leave_one_pair_out": {
                "properties": {
                  "status": {
                    "enum": [
                      "complete",
                      "not_applicable"
                    ]
                  }
                }
              },
              "candidate_selection": {
                "properties": {
                  "status": {
                    "const": "complete"
                  }
                }
              },
              "candidate_adjudication": {
                "properties": {
                  "status": {
                    "const": "complete"
                  }
                }
              },
              "decisions": {
                "properties": {
                  "status": {
                    "const": "complete"
                  }
                }
              },
              "limitations": {
                "properties": {
                  "status": {
                    "const": "complete"
                  }
                }
              }
            }
          },
          "decisions": {
            "properties": {
              "orientation": {
                "properties": {
                  "status": {
                    "const": "recorded"
                  }
                }
              },
              "annotation": {
                "properties": {
                  "status": {
                    "const": "recorded"
                  }
                }
              },
              "thresholds": {
                "properties": {
                  "status": {
                    "const": "recorded"
                  }
                }
              },
              "background": {
                "properties": {
                  "status": {
                    "const": "recorded"
                  }
                }
              },
              "matched_dna": {
                "properties": {
                  "status": {
                    "const": "recorded"
                  }
                }
              },
              "orthogonal_evidence": {
                "properties": {
                  "status": {
                    "const": "recorded"
                  }
                }
              },
              "adjudication": {
                "properties": {
                  "status": {
                    "const": "recorded"
                  }
                }
              }
            }
          },
          "review_metadata": {
            "properties": {
              "review_completed_date": {
                "type": "string",
                "format": "date"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "scientific_state": {
            "properties": {
              "overall_status": {
                "const": "evidence_incomplete"
              }
            },
            "required": [
              "overall_status"
            ]
          }
        },
        "required": [
          "scientific_state"
        ]
      },
      "then": {
        "properties": {
          "review_metadata": {
            "properties": {
