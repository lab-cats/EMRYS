# Copy to .env in the NORAD source checkout, chmod it 600, and replace every
# placeholder.
# Values are literal: do not add shell quotes, substitutions, or inline comments.
NORAD_SLURM_ACCOUNT=replace-with-site-account
NORAD_SLURM_PARTITION=replace-with-site-partition
NORAD_SLURM_QOS=replace-with-site-qos
NORAD_SLURM_NODELIST=

NORAD_LOG_DIR=/absolute/path/to/slurm-logs
NORAD_WORKSPACE=/absolute/path/to/norad-workspace
NORAD_SCRATCH_PARENT=/absolute/path/to/compute-scratch
