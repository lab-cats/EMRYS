# Copy to .env in the EMRYS source checkout, chmod it 600, and replace every
# placeholder.
# Values are literal: do not add shell quotes, substitutions, or inline comments.
EMRYS_SLURM_ACCOUNT=replace-with-site-account
EMRYS_SLURM_PARTITION=replace-with-site-partition
EMRYS_SLURM_QOS=replace-with-site-qos
EMRYS_SLURM_NODELIST=

EMRYS_LOG_DIR=/absolute/path/to/slurm-logs
EMRYS_WORKSPACE=/absolute/path/to/emrys-workspace
EMRYS_SCRATCH_PARENT=/absolute/path/to/compute-scratch
