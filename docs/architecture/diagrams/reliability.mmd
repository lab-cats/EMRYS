flowchart LR
    inputs["Explicit inputs<br/>paths + identities + hashes"] --> dryrun["Dry-run-first interface<br/>legacy exceptions documented per stage"]
    dryrun --> modern["Modern multi-file publisher"]
    dryrun --> legacy["Legacy or single-output stage<br/>stage-specific validation and recovery"]
    modern --> lock["Owned lock"]
    lock --> stage["Run-token staging"]
    stage --> validate["Validate outputs and recheck inputs"]
    validate --> publish["Validated producer-specific publication"]
    publish --> marker["Receipt or summary published last<br/>(marker alone may not prove final producer success)"]
    validate --> rollback["Rollback on failure"]
    rollback --> recovery["Preserve recovery evidence when uncertain"]
