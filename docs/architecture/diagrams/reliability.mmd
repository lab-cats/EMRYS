flowchart LR
    inputs["Explicit inputs<br/>paths + identities + hashes"] --> dryrun["Side-effect-free dry-run"]
    dryrun --> lock["Owned lock"]
    lock --> stage["Run-token staging"]
    stage --> validate["Validate outputs and recheck inputs"]
    validate --> publish["Atomic publication"]
    publish --> marker["Receipt or summary published last"]
    validate --> rollback["Rollback on failure"]
    rollback --> recovery["Preserve recovery evidence when uncertain"]
