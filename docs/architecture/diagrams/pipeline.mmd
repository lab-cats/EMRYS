flowchart LR
    subgraph inputs["Explicit external inputs"]
        references["Materialized FASTA/GTF and declared reference artifacts"]
        reads["Paired FASTQ"]
        manifests["Sample and partition manifests"]
    end

    subgraph workflow["Current functional-owner workflow under src/emrys/"]
        reference_owners["Reference-derived owners (00a/00b/00c)"]
        sample_owners["Per-sample alignment and BAM owners (01-06)"]
        evidence_branches["Non-gating QC/orientation evidence (02b/03)"]
        cohort_owners["Declared cohort preprocessing (07/08)"]
        analysis["First-class paired-CMH analysis (09)"]
        context["Scientific-context projection (10)"]

        reference_owners -->|"STAR index to 01; FAI/DICT to 05"| sample_owners
        reference_owners -.->|"BED12 to 03"| evidence_branches
        sample_owners -.-> evidence_branches
        sample_owners --> cohort_owners
        reference_owners -->|"FAI to 07"| cohort_owners
        cohort_owners --> analysis
        analysis --> context
        reference_owners -->|"FAI; external FASTA continues"| context
    end

    references --> reference_owners
    references -->|"FASTA to 05"| sample_owners
    references -->|"FASTA to 07; GTF to 08"| cohort_owners
    reads --> sample_owners
    manifests --> cohort_owners
    manifests --> analysis

    registered["Declared artifacts plus owner-local validation evidence<br/>(grouped projection; exact edges live in STAGE_MAP)"]
    adapters["Read-only artifact indexing"]
    summary["Canonical run summary"]
    report["Receipt-last HTML/TSV report transaction"]

    reference_owners --> registered
    sample_owners --> registered
    evidence_branches --> registered
    cohort_owners --> registered
    analysis --> registered
    context --> registered
    registered --> adapters --> summary --> report

    external_process["External review, adjudication, and biological interpretation records<br/>(outside EMRYS; never a pipeline gate)"]
    report -.->|"research work process may reference outputs"| external_process

    runtime_profile["Explicit runtime profile"] --> runtime_preflight["Read-only runtime availability evidence"]
    reference_inventory["Explicit reference inventory"] --> reference_provenance["Read-only reference provenance evidence"]
    storage_contracts["Explicit storage roots and retention policy"] --> storage_inventory["Read-only storage evidence"]
