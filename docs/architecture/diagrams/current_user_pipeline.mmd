flowchart LR
    reference_contracts["Reference + annotation contracts<br/>FASTA / FAI / GTF / BED12"]
    run_contracts["Sample + partition + analysis contracts<br/>paired FASTQ / manifests / thresholds"]
    optional_background["Independent background cohort<br/>(optional)"]

    prepare_reference["Prepare reference<br/>STAR index / BED12 / FASTA sidecars"]
    align["Align reads"]
    canonicalize["Canonicalize BAM"]
    inspect["Inspect QC + mechanical orientation<br/>(non-gating evidence)"]
    prepare_reads["Prepare read evidence<br/>mark duplicates / split N cigar / partition"]
    observe["Observe declared cohort<br/>partitioned orientation VCFs"]
    normalize["Normalize + annotate candidates"]
    rank["Rank paired candidates<br/>CMH-ranked outputs"]
    context["Project scientific context<br/>indexed reference + registered PUM motif"]
    reporting["Read-only reporting<br/>scientific HTML + evidence/provenance HTML + summary TSV<br/>validated v4 receipt last"]
    external_process["External review, adjudication, and biological interpretation records<br/>(outside NORAD; never a pipeline gate)"]

    reference_contracts --> prepare_reference
    run_contracts --> align
    prepare_reference -->|STAR index| align
    align --> canonicalize
    canonicalize -.->|BAM/BAI evidence branch| inspect
    canonicalize --> prepare_reads
    reference_contracts -.->|FAI continues| prepare_reads
    prepare_reads --> observe
    run_contracts -.->|sample + partition manifests continue| observe
    reference_contracts -.->|FASTA / FAI continue| observe
    observe --> normalize
    reference_contracts -.->|GTF continues| normalize
    run_contracts -.->|manifests continue| normalize
    normalize --> rank
    run_contracts -.->|manifests + thresholds continue| rank
    optional_background -.->|if declared| rank
    rank --> context
    reference_contracts -.->|FASTA / FAI continue| context
    context --> reporting
    reporting -.->|research work process may reference outputs| external_process

    dependency_legend["Legend: arrows are data or contract dependencies,<br/>not automatic scheduling"]
