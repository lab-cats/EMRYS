flowchart TD
    ready["Ready YAML request"] --> manifest["Referenced TSV sample manifest"]
    ready --> claim["Atomic request claim"]
    manifest --> claim
    raw["Stationary FASTQ and registered reference inputs"] --> normalize["Resolve, validate, hash, and normalize"]
    claim --> normalize
    normalize --> identity{"Normalized contract identity"}
    identity -->|"Same contract"| run["Existing immutable run"]
    identity -->|"Changed input or policy"| newrun["New immutable run"]
    run --> attempt["New inspectable attempt"]
    newrun --> attempt
    attempt --> execute["Required DAG, validators, evidence, and requested report"]
    execute -->|"Failure"| resumable["Failed and resumable request state"]
    execute -->|"Current success contract"| promote["Promote request and run metadata"]
    raw -.->|Never moved automatically| promote
