{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:emrys:schema:orchestration:resource-config:v1",
  "title": "EMRYS run-coordinator resource configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version"
  ],
  "$defs": {
    "positive_integer": {
      "type": "integer",
      "minimum": 1
    },
    "allocation_value": {
      "oneOf": [
        {
          "$ref": "#/$defs/positive_integer"
        },
        {
          "const": "allocation"
        }
      ]
    },
    "workflow_value": {
      "oneOf": [{ "$ref": "#/$defs/auto_value" }, { "const": "workflow" }]
    },
    "auto_value": {
      "oneOf": [{ "$ref": "#/$defs/positive_integer" }, { "const": "auto" }]
    },
    "stage_memory_value": {
      "oneOf": [
        { "$ref": "#/$defs/workflow_value" },
        {
          "type": "object", "additionalProperties": false,
          "required": ["minimum_mb"],
          "properties": { "minimum_mb": { "$ref": "#/$defs/positive_integer" } }
        }
      ]
    },
    "stage_concurrency": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "01": { "$ref": "#/$defs/auto_value" },
        "02": { "$ref": "#/$defs/auto_value" },
        "02b": { "$ref": "#/$defs/auto_value" },
        "03": { "$ref": "#/$defs/auto_value" },
        "04": { "$ref": "#/$defs/auto_value" },
        "05": { "$ref": "#/$defs/auto_value" },
        "06": { "$ref": "#/$defs/auto_value" },
        "07": { "$ref": "#/$defs/auto_value" }
      }
    },
    "step_threads": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "00a": { "$ref": "#/$defs/workflow_value" },
        "00c": { "$ref": "#/$defs/workflow_value" },
        "02b": { "$ref": "#/$defs/workflow_value" },
        "04": { "$ref": "#/$defs/workflow_value" },
        "05": { "$ref": "#/$defs/workflow_value" },
        "01": { "$ref": "#/$defs/workflow_value" },
        "02": { "$ref": "#/$defs/workflow_value" },
        "06": { "$ref": "#/$defs/workflow_value" },
        "08": { "$ref": "#/$defs/workflow_value" },
        "09": { "$ref": "#/$defs/workflow_value" },
        "10": { "$ref": "#/$defs/workflow_value" }
      }
    },
    "stage_memory": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "00a": { "$ref": "#/$defs/stage_memory_value" },
        "00b": { "$ref": "#/$defs/stage_memory_value" },
        "00c": { "$ref": "#/$defs/stage_memory_value" },
        "01": { "$ref": "#/$defs/stage_memory_value" },
        "02": { "$ref": "#/$defs/stage_memory_value" },
        "02b": { "$ref": "#/$defs/stage_memory_value" },
        "03": { "$ref": "#/$defs/stage_memory_value" },
        "04": { "$ref": "#/$defs/stage_memory_value" },
        "05": { "$ref": "#/$defs/stage_memory_value" },
        "06": { "$ref": "#/$defs/stage_memory_value" },
        "07": { "$ref": "#/$defs/stage_memory_value" },
        "08": { "$ref": "#/$defs/stage_memory_value" },
        "09": { "$ref": "#/$defs/stage_memory_value" },
        "10": { "$ref": "#/$defs/stage_memory_value" }
      }
    }
  },
  "properties": {
    "schema_version": {
      "const": "emrys.local-pilot-resources.v1"
    },
    "workflow_cores": {
      "$ref": "#/$defs/allocation_value"
    },
    "workflow_memory_mb": {
      "$ref": "#/$defs/allocation_value"
    },
    "stage_concurrency": {
      "$ref": "#/$defs/stage_concurrency"
    },
    "step_threads": {
      "$ref": "#/$defs/step_threads"
    },
    "stage_memory_mb": {
      "$ref": "#/$defs/stage_memory"
    }
  }
}
