{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:emrys:schema:orchestration:execution-profile:v1",
  "title": "EMRYS execution profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version"],
  "$defs": {
    "slurm_name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "positive_integer": {
      "type": "integer",
      "minimum": 1
    },
    "absolute_nonroot_path": {
      "type": "string",
      "pattern": "^/[^\\u0000-\\u001f\\u007f,]+$"
    },
    "modules": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "init", "load"],
          "properties": {
            "mode": {"const": "none"},
            "init": {"const": ""},
            "load": {"type": "array", "maxItems": 0}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "init", "load"],
          "properties": {
            "mode": {"const": "exact"},
            "init": {"$ref": "#/$defs/absolute_nonroot_path"},
            "load": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._+/-]*$"
              }
            }
          }
        }
      ]
    },
    "direct_placement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"const": "direct"}
      }
    },
    "slurm_placement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "account",
        "partition",
        "qos",
        "cpus_per_task",
        "memory_mb",
        "time",
        "exclusive",
        "nodelist",
        "scratch_parent",
        "modules"
      ],
      "properties": {
        "kind": {"const": "slurm"},
        "account": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/slurm_name"}
          ]
        },
        "partition": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/slurm_name"}
          ]
        },
        "qos": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/slurm_name"}
          ]
        },
        "cpus_per_task": {"$ref": "#/$defs/positive_integer"},
        "memory_mb": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/positive_integer"}
          ]
        },
        "time": {
          "type": "string",
          "pattern": "^(?:(?:[0-9]+-)?[0-9]{1,2}:[0-9]{2}(?::[0-9]{2})?|[1-9][0-9]*)$"
        },
        "exclusive": {"type": "boolean"},
        "nodelist": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._,\\[\\]-]*$"
            }
          ]
        },
        "scratch_parent": {"$ref": "#/$defs/absolute_nonroot_path"},
        "modules": {"$ref": "#/$defs/modules"}
      }
    }
  },
  "properties": {
    "schema_version": {"const": "emrys.execution-profile.v1"},
    "resources": {
      "$ref": "urn:emrys:schema:orchestration:resource-config:v1"
    },
    "placement": {
      "oneOf": [
        {"$ref": "#/$defs/direct_placement"},
        {"$ref": "#/$defs/slurm_placement"}
      ]
    }
  }
}
