{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:emrys:schema:orchestration:launcher-config:v1",
  "title": "EMRYS local-pilot launcher configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version"
  ],
  "$defs": {
    "nonempty_literal": {
      "type": "string",
      "minLength": 1
    },
    "positive_integer": {
      "type": "integer",
      "minimum": 1
    },
    "slurm_memory_literal": {
      "type": "string",
      "pattern": "^(?:site-default|[1-9][0-9]*[KMGTP]?)$"
    },
    "slurm_time_literal": {
      "type": "string",
      "pattern": "^(?:(?:[0-9]+-)?[0-9]{1,2}:[0-9]{2}(?::[0-9]{2})?|[1-9][0-9]*)$"
    },
    "nodelist_literal": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._,\\[\\]-]*$"
    },
    "module_load_literal": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "env_slurm_account": {
      "type": "object",
      "additionalProperties": false,
      "required": ["env"],
      "properties": {
        "env": {"const": "EMRYS_SLURM_ACCOUNT"}
      }
    },
    "env_slurm_partition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["env"],
      "properties": {
        "env": {"const": "EMRYS_SLURM_PARTITION"}
      }
    },
    "env_slurm_qos": {
      "type": "object",
      "additionalProperties": false,
      "required": ["env"],
      "properties": {
        "env": {"const": "EMRYS_SLURM_QOS"}
      }
    },
    "env_slurm_cpus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["env"],
      "properties": {
        "env": {"const": "EMRYS_SLURM_CPUS"}
      }
    },
    "env_slurm_memory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["env"],
      "properties": {
        "env": {"const": "EMRYS_SLURM_MEMORY"}
      }
    },
    "env_slurm_time": {
      "type": "object",
      "additionalProperties": false,
      "required": ["env"],
      "properties": {
        "env": {"const": "EMRYS_SLURM_TIME"}
      }
    },
    "env_slurm_exclusive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["env"],
      "properties": {
        "env": {"const": "EMRYS_SLURM_EXCLUSIVE"}
      }
    },
    "env_slurm_nodelist": {
      "type": "object",
      "additionalProperties": false,
      "required": ["env"],
      "properties": {
        "env": {"const": "EMRYS_SLURM_NODELIST"}
      }
    },
    "env_log_dir": {
      "type": "object",
      "additionalProperties": false,
      "required": ["env"],
      "properties": {
        "env": {"const": "EMRYS_LOG_DIR"}
      }
    },
    "env_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["env"],
      "properties": {
        "env": {"const": "EMRYS_REQUEST"}
      }
    },
    "env_workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["env"],
      "properties": {
        "env": {"const": "EMRYS_WORKSPACE"}
      }
    },
    "env_runtime_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["env"],
      "properties": {
        "env": {"const": "EMRYS_RUNTIME_PROFILE"}
      }
    },
    "env_scratch_parent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["env"],
      "properties": {
        "env": {"const": "EMRYS_SCRATCH_PARENT"}
      }
    },
    "env_module_mode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["env"],
      "properties": {
        "env": {"const": "EMRYS_MODULE_MODE"}
      }
    },
    "env_module_init": {
      "type": "object",
      "additionalProperties": false,
      "required": ["env"],
      "properties": {
        "env": {"const": "EMRYS_MODULE_INIT"}
      }
    },
    "env_module_load": {
      "type": "object",
      "additionalProperties": false,
      "required": ["env"],
      "properties": {
        "env": {"const": "EMRYS_MODULES"}
      }
    }
  },
  "properties": {
    "schema_version": {
      "const": "emrys.local-pilot-launcher.v1"
    },
    "slurm": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "account": {
          "oneOf": [
            {"$ref": "#/$defs/nonempty_literal"},
            {"$ref": "#/$defs/env_slurm_account"}
          ]
        },
        "partition": {
          "oneOf": [
            {"$ref": "#/$defs/nonempty_literal"},
            {"$ref": "#/$defs/env_slurm_partition"}
          ]
        },
        "qos": {
          "oneOf": [
            {"$ref": "#/$defs/nonempty_literal"},
            {"$ref": "#/$defs/env_slurm_qos"}
          ]
        },
        "cpus_per_task": {
          "oneOf": [
            {"$ref": "#/$defs/positive_integer"},
            {"$ref": "#/$defs/env_slurm_cpus"}
          ]
        },
        "memory": {
          "oneOf": [
            {"$ref": "#/$defs/slurm_memory_literal"},
            {"$ref": "#/$defs/env_slurm_memory"}
          ]
        },
        "time": {
          "oneOf": [
            {"$ref": "#/$defs/slurm_time_literal"},
            {"$ref": "#/$defs/env_slurm_time"}
          ]
        },
        "exclusive": {
          "oneOf": [
            {"type": "boolean"},
            {"$ref": "#/$defs/env_slurm_exclusive"}
          ]
        },
        "nodelist": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/nodelist_literal"},
            {"$ref": "#/$defs/env_slurm_nodelist"}
          ]
        }
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "log_dir": {
          "oneOf": [
            {"$ref": "#/$defs/nonempty_literal"},
            {"$ref": "#/$defs/env_log_dir"}
          ]
        },
        "request": {
          "oneOf": [
            {"$ref": "#/$defs/nonempty_literal"},
            {"$ref": "#/$defs/env_request"}
          ]
        },
        "workspace": {
          "oneOf": [
            {"$ref": "#/$defs/nonempty_literal"},
            {"$ref": "#/$defs/env_workspace"}
          ]
        },
        "runtime_profile": {
          "oneOf": [
            {"$ref": "#/$defs/nonempty_literal"},
            {"$ref": "#/$defs/env_runtime_profile"}
          ]
        },
        "scratch_parent": {
          "oneOf": [
            {"$ref": "#/$defs/nonempty_literal"},
            {"$ref": "#/$defs/env_scratch_parent"}
          ]
        }
      }
    },
    "modules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "oneOf": [
            {"enum": ["none", "exact"]},
            {"$ref": "#/$defs/env_module_mode"}
          ]
        },
        "init": {
          "oneOf": [
            {"type": "string"},
            {"$ref": "#/$defs/env_module_init"}
          ]
        },
        "load": {
          "oneOf": [
            {"$ref": "#/$defs/module_load_literal"},
            {"$ref": "#/$defs/env_module_load"}
          ]
        }
      }
    }
  }
}
