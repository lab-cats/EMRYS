{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:emrys:schema:orchestration:common:v1",
  "title": "EMRYS orchestration common definitions v1",
  "$defs": {
    "safe_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "git_commit": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "non_empty_string": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\s)(?:.|\\n)*(?<!\\s)$"
    },
    "authored_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\s)(?!.*\\s$)(?!~)(?!.*//)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[$\\{\\}])(?!.*[*?\\[\\]\\u0000\\r\\n]).+$"
    },
    "absolute_path": {
      "type": "string",
      "minLength": 2,
      "pattern": "^/(?!.*//)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[$\\{\\}])(?!.*[*?\\[\\]\\u0000\\r\\n]).+$"
    },
    "relative_contract_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\s)(?!.*\\s$)(?!/)(?!.*//)(?!.*\\/$)(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$))(?!.*[$\\{\\}])(?!.*[*?\\[\\]\\\\\\u0000\\r\\n]).+$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run-[0-9a-f]{64}$"
    },
    "workflow_attempt_id": {
      "type": "string",
      "pattern": "^workflow-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{32}$"
    },
    "task_attempt_id": {
      "type": "string",
      "pattern": "^task-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{32}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "file_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "size_bytes",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/absolute_path"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "record_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relative_contract_path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope_type",
        "scope_id"
      ],
      "properties": {
        "scope_type": {
          "enum": [
            "reference",
            "sample",
            "cohort_partition",
            "cohort",
            "analysis",
            "reporting"
          ]
        },
        "scope_id": {
          "$ref": "#/$defs/safe_id"
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "argv",
        "exit_code"
      ],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "exit_code": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        }
      }
    },
    "successful_command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "argv",
        "exit_code"
      ],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "exit_code": {
          "const": 0
        }
      }
    },
    "nullable_command": {
      "oneOf": [
        {
          "$ref": "#/$defs/command"
        },
        {
          "type": "null"
        }
      ]
    },
    "bound_file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "path",
        "size_bytes",
        "sha256"
      ],
      "properties": {
        "role": {
          "$ref": "#/$defs/safe_id"
        },
        "path": {
          "$ref": "#/$defs/absolute_path"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "tool_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "path",
        "resolved_path",
        "sha256"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/safe_id"
        },
        "version": {
          "$ref": "#/$defs/non_empty_string"
        },
        "path": {
          "$ref": "#/$defs/absolute_path"
        },
        "resolved_path": {
          "$ref": "#/$defs/absolute_path"
        },
        "sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "identity_kind": {
          "enum": ["file", "package_tree"]
        }
      }
    },
    "installed_package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "distribution", "version", "content_sha256", "git_commit", "git_dirty", "python_lock_sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/absolute_path"},
        "distribution": {"const": "emrys-rna-workflow"},
        "version": {"$ref": "#/$defs/non_empty_string"},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "git_commit": {"oneOf": [{"$ref": "#/$defs/git_commit"}, {"type": "null"}]},
        "git_dirty": {"type": ["boolean", "null"]},
        "python_lock_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
