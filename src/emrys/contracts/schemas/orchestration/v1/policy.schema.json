{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:emrys:schema:orchestration:policy:v1",
  "title": "EMRYS admitted analysis policy",
  "$defs": {
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module_id", "interface_version", "module_version", "trust",
        "distribution_name", "distribution_version", "entry_point",
        "config_schema_sha256", "required_runtime_checks"
      ],
      "properties": {
        "module_id": {"$ref": "urn:emrys:schema:orchestration:common:v1#/$defs/safe_id"},
        "interface_version": {"$ref": "urn:emrys:schema:orchestration:common:v1#/$defs/safe_id"},
        "module_version": {"$ref": "urn:emrys:schema:orchestration:common:v1#/$defs/safe_id"},
        "trust": {"enum": ["built-in", "external"]},
        "distribution_name": {"type": "string", "minLength": 1},
        "distribution_version": {"type": "string", "minLength": 1},
        "entry_point": {"type": "string", "minLength": 1},
        "config_schema_sha256": {"$ref": "urn:emrys:schema:orchestration:common:v1#/$defs/sha256"},
        "required_runtime_checks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "urn:emrys:schema:orchestration:common:v1#/$defs/safe_id"}
        }
      }
    },
    "module_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "analysis_id", "module", "configuration"],
      "properties": {
        "schema_version": {"const": "emrys.analysis-module-policy.v1"},
        "analysis_id": {"$ref": "urn:emrys:schema:orchestration:common:v1#/$defs/safe_id"},
        "module": {"$ref": "#/$defs/module"},
        "configuration": {"type": "object"}
      }
    },
    "paired_cmh_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "analysis_id", "control_condition", "treatment_condition",
        "rna_ref", "rna_alt", "min_sample_dp", "mean_dp_threshold",
        "fdr_threshold", "common_or_threshold", "absolute_difference_threshold",
        "background_condition", "background_max_fraction"
      ],
      "properties": {
        "schema_version": {"const": "emrys.analysis-policy.v1"},
        "analysis_id": {"$ref": "urn:emrys:schema:orchestration:common:v1#/$defs/safe_id"},
        "control_condition": {"$ref": "urn:emrys:schema:orchestration:common:v1#/$defs/safe_id"},
        "treatment_condition": {"$ref": "urn:emrys:schema:orchestration:common:v1#/$defs/safe_id"},
        "rna_ref": {"type": "string", "pattern": "^[ACGT]$"},
        "rna_alt": {"type": "string", "pattern": "^[ACGT]$"},
        "min_sample_dp": {"type": "integer", "minimum": 1},
        "mean_dp_threshold": {"type": "number", "minimum": 0},
        "fdr_threshold": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "common_or_threshold": {"type": "number", "exclusiveMinimum": 1},
        "absolute_difference_threshold": {"type": "number", "minimum": 0, "maximum": 1},
        "background_condition": {
          "oneOf": [
            {"$ref": "urn:emrys:schema:orchestration:common:v1#/$defs/safe_id"},
            {"type": "null"}
          ]
        },
        "background_max_fraction": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1}
      }
    }
  },
  "oneOf": [
    {"$ref": "#/$defs/paired_cmh_policy"},
    {"$ref": "#/$defs/module_policy"}
  ]
}
