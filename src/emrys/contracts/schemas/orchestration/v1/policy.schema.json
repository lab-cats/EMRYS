{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:emrys:schema:orchestration:policy:v1",
  "title": "EMRYS primary analysis policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "analysis_id",
    "control_condition",
    "treatment_condition",
    "rna_ref",
    "rna_alt",
    "min_sample_dp",
    "mean_dp_threshold",
    "fdr_threshold",
    "common_or_threshold",
    "absolute_difference_threshold",
    "background_condition",
    "background_max_fraction"
  ],
  "properties": {
    "schema_version": {
      "const": "emrys.analysis-policy.v1"
    },
    "analysis_id": {
      "$ref": "urn:emrys:schema:orchestration:common:v1#/$defs/safe_id"
    },
    "control_condition": {
      "$ref": "urn:emrys:schema:orchestration:common:v1#/$defs/safe_id"
    },
    "treatment_condition": {
      "$ref": "urn:emrys:schema:orchestration:common:v1#/$defs/safe_id"
    },
    "rna_ref": {
      "type": "string",
      "pattern": "^[ACGT]$"
    },
    "rna_alt": {
      "type": "string",
      "pattern": "^[ACGT]$"
    },
    "min_sample_dp": {
      "type": "integer",
      "minimum": 1
    },
    "mean_dp_threshold": {
      "type": "number",
      "minimum": 0
    },
    "fdr_threshold": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1
    },
    "common_or_threshold": {
      "type": "number",
      "exclusiveMinimum": 1
    },
    "absolute_difference_threshold": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "background_condition": {
      "oneOf": [
        {
          "$ref": "urn:emrys:schema:orchestration:common:v1#/$defs/safe_id"
        },
        {
          "type": "null"
        }
      ]
    },
    "background_max_fraction": {
      "type": "number",
      "exclusiveMinimum": 0,
      "exclusiveMaximum": 1
    }
  }
}
