{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:emrys:schema:orchestration:verified-reporting:v1",
  "title": "EMRYS semantically verified reporting transaction v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "execution_contract_sha256",
    "profile_sha256",
    "origin_workflow_attempt_id",
    "kind",
    "reporting_start",
    "semantic_receipt",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "emrys.verified-reporting.v1"
    },
    "run_id": {
      "$ref": "urn:emrys:schema:orchestration:common:v1#/$defs/run_id"
    },
    "execution_contract_sha256": {
      "$ref": "urn:emrys:schema:orchestration:common:v1#/$defs/sha256"
    },
    "profile_sha256": {
      "$ref": "urn:emrys:schema:orchestration:common:v1#/$defs/sha256"
    },
    "origin_workflow_attempt_id": {
      "$ref": "urn:emrys:schema:orchestration:common:v1#/$defs/workflow_attempt_id"
    },
    "kind": {
      "enum": [
        "artifact_index",
        "run_summary",
        "html_report"
      ]
    },
    "reporting_start": {
      "$ref": "urn:emrys:schema:orchestration:common:v1#/$defs/record_reference"
    },
    "semantic_receipt": {
      "$ref": "urn:emrys:schema:orchestration:common:v1#/$defs/record_reference"
    },
    "created_at": {
      "$ref": "urn:emrys:schema:orchestration:common:v1#/$defs/timestamp"
    }
  }
}
