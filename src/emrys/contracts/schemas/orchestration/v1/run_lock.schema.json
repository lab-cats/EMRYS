{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:emrys:schema:orchestration:run-lock:v1",
  "title": "EMRYS owned local run lock v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "workflow_attempt_id",
    "attempt_record_path",
    "owner_token",
    "process_id",
    "host",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "emrys.run-lock.v1"
    },
    "run_id": {
      "$ref": "urn:emrys:schema:orchestration:common:v1#/$defs/run_id"
    },
    "workflow_attempt_id": {
      "$ref": "urn:emrys:schema:orchestration:common:v1#/$defs/workflow_attempt_id"
    },
    "attempt_record_path": {
      "$ref": "urn:emrys:schema:orchestration:common:v1#/$defs/relative_contract_path"
    },
    "owner_token": {
      "$ref": "urn:emrys:schema:orchestration:common:v1#/$defs/safe_id"
    },
    "process_id": {
      "type": "integer",
      "minimum": 1
    },
    "host": {
      "$ref": "urn:emrys:schema:orchestration:common:v1#/$defs/non_empty_string"
    },
    "created_at": {
      "$ref": "urn:emrys:schema:orchestration:common:v1#/$defs/timestamp"
    }
  }
}
