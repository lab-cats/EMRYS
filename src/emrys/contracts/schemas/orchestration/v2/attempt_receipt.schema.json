{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:emrys:schema:orchestration:attempt-receipt:v2",
  "title": "EMRYS terminal scientific workflow attempt receipt v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "execution_contract_sha256",
    "profile_sha256",
    "workflow_attempt_id",
    "attempt_record",
    "released_run_lock",
    "status",
    "finished_at",
    "snakemake_exit_code",
    "termination_signal",
    "preentry_task_attempt_records",
    "task_start_records",
    "verified_tasks",
    "blockers",
    "message"
  ],
  "properties": {
    "schema_version": {
      "const": "emrys.attempt-receipt.v2"
    },
    "run_id": {
      "$ref": "urn:emrys:schema:orchestration:common:v1#/$defs/run_id"
    },
    "execution_contract_sha256": {
      "$ref": "urn:emrys:schema:orchestration:common:v1#/$defs/sha256"
    },
    "profile_sha256": {
      "$ref": "urn:emrys:schema:orchestration:common:v1#/$defs/sha256"
    },
    "workflow_attempt_id": {
      "$ref": "urn:emrys:schema:orchestration:common:v1#/$defs/workflow_attempt_id"
    },
    "attempt_record": {
      "$ref": "urn:emrys:schema:orchestration:common:v1#/$defs/record_reference"
    },
    "released_run_lock": {
      "$ref": "urn:emrys:schema:orchestration:common:v1#/$defs/record_reference"
    },
    "status": {
      "enum": [
        "succeeded",
        "failed",
        "interrupted",
        "blocked"
      ]
    },
    "finished_at": {
      "$ref": "urn:emrys:schema:orchestration:common:v1#/$defs/timestamp"
    },
    "snakemake_exit_code": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        {
          "type": "null"
        }
      ]
    },
    "termination_signal": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "preentry_task_attempt_records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "workflow_attempt_id",
          "machine_key",
          "scope",
          "record"
        ],
        "properties": {
          "workflow_attempt_id": {
            "$ref": "urn:emrys:schema:orchestration:common:v1#/$defs/workflow_attempt_id"
          },
          "machine_key": {
            "$ref": "urn:emrys:schema:orchestration:common:v1#/$defs/safe_id"
          },
          "scope": {
            "$ref": "urn:emrys:schema:orchestration:common:v1#/$defs/scope"
          },
          "record": {
            "$ref": "urn:emrys:schema:orchestration:common:v1#/$defs/record_reference"
          }
        }
      }
    },
    "task_start_records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "machine_key",
          "scope",
          "record"
        ],
        "properties": {
          "machine_key": {
            "$ref": "urn:emrys:schema:orchestration:common:v1#/$defs/safe_id"
          },
          "scope": {
            "$ref": "urn:emrys:schema:orchestration:common:v1#/$defs/scope"
          },
          "record": {
            "$ref": "urn:emrys:schema:orchestration:common:v1#/$defs/record_reference"
          }
        }
      }
    },
    "verified_tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "machine_key",
          "scope",
          "record"
        ],
        "properties": {
          "machine_key": {
            "$ref": "urn:emrys:schema:orchestration:common:v1#/$defs/safe_id"
          },
          "scope": {
            "$ref": "urn:emrys:schema:orchestration:common:v1#/$defs/scope"
          },
          "record": {
            "$ref": "urn:emrys:schema:orchestration:common:v1#/$defs/record_reference"
          }
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "$ref": "urn:emrys:schema:orchestration:common:v1#/$defs/non_empty_string"
      }
    },
    "message": {
      "oneOf": [
        {
          "$ref": "urn:emrys:schema:orchestration:common:v1#/$defs/non_empty_string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "succeeded"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "verified_tasks": {
            "minItems": 1
          },
          "message": {
            "type": "null"
          },
          "blockers": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
