{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:emrys:schema:artifacts:common:v1",
  "title": "EMRYS artifact common definitions v1",
  "description": "Shared definitions for the EMRYS artifact-schema-v1 record contracts.",
  "$defs": {
    "safe_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\s)(?!.*\\s$)(?!.*//)(?!.*\\$\\{)(?!.*\\{\\{)(?!.*\\}\\})(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$))[^*?\\[\\]\\u0000\\r\\n]+$"
    },
    "git_commit": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "evidence_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "role",
        "path",
        "sha256"
      ],
      "properties": {
        "evidence_id": {
          "$ref": "#/$defs/safe_id"
        },
        "role": {
          "enum": [
            "implementation",
            "local_test",
            "runtime_log",
            "runtime_output",
            "cluster_dry_run",
            "cluster_scheduler",
            "cluster_log",
            "cluster_output",
            "scientific_evidence",
            "validation_record",
            "receipt",
            "source_manifest"
          ]
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "path_hash": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "row_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "media_type": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "related_artifact_ids",
        "evidence"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/safe_id"
        },
        "message": {
          "$ref": "#/$defs/non_empty_string"
        },
        "related_artifact_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/safe_id"
          },
          "uniqueItems": true
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_reference"
          }
        }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric_id",
        "name",
        "value",
        "unit",
        "status",
        "source_artifact_id"
      ],
      "properties": {
        "metric_id": {
          "$ref": "#/$defs/safe_id"
        },
        "name": {
          "$ref": "#/$defs/non_empty_string"
        },
        "value": {
          "type": [
            "number",
            "integer",
            "string",
            "boolean",
            "null"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "pass",
            "flag",
            "fail",
            "not_assessed"
          ]
        },
        "source_artifact_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/safe_id"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer",
        "producer_version",
        "git_commit",
        "created_at"
      ],
      "properties": {
        "producer": {
          "$ref": "#/$defs/safe_id"
        },
        "producer_version": {
          "$ref": "#/$defs/non_empty_string"
        },
        "git_commit": {
          "$ref": "#/$defs/git_commit"
        },
        "installed_package": {
          "$ref": "urn:emrys:schema:orchestration:common:v1#/$defs/installed_package"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "run_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_contract_sha256",
        "sample_manifest_sha256",
        "reference_contract_sha256",
        "partition_manifest_sha256",
        "primary_analysis_id",
        "primary_analysis_policy_sha256"
      ],
      "properties": {
        "run_contract_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "sample_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "reference_contract_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "partition_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "primary_analysis_id": {
          "$ref": "#/$defs/safe_id"
        },
        "primary_analysis_policy_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_id",
        "scope_type",
        "scope_id"
      ],
      "properties": {
        "step_id": {
          "$ref": "#/$defs/safe_id"
        },
        "scope_type": {
          "$ref": "#/$defs/safe_id"
        },
        "scope_id": {
          "$ref": "#/$defs/safe_id"
        }
      }
    }
  }
}
