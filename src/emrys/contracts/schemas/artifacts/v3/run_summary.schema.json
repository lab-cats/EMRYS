{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:emrys:schema:artifacts:run-summary:v6",
  "title": "EMRYS Run result manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "record_type",
    "run_id",
    "run_contract",
    "summary_state",
    "generated_at",
    "inventory",
    "expected_scopes",
    "artifacts",
    "computational_rollup",
    "parameters",
    "qc_metrics",
    "limitations",
    "analysis_policy",
    "warnings",
    "errors",
    "provenance",
    "scientific_origin",
    "tables",
    "run_contract_file",
    "publication"
  ],
  "properties": {
    "schema_name": {"const": "emrys.run_summary"},
    "schema_version": {"const": "6.0.0"},
    "record_type": {"const": "run_summary"},
    "run_id": {"$ref": "urn:emrys:schema:artifacts:common:v1#/$defs/safe_id"},
    "run_contract": {"$ref": "urn:emrys:schema:artifacts:common:v1#/$defs/run_contract"},
    "summary_state": {"enum": ["complete", "incomplete", "failed"]},
    "generated_at": {"type": "string", "format": "date-time"},
    "inventory": {"$ref": "urn:emrys:schema:artifacts:common:v1#/$defs/path_hash"},
    "expected_scopes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "urn:emrys:schema:artifacts:run-summary:v6#/$defs/expected_scope"}
    },
    "artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "urn:emrys:schema:artifacts:artifact-entry:v3"}},
    "computational_rollup": {"$ref": "urn:emrys:schema:artifacts:run-summary:v6#/$defs/computational_rollup"},
    "parameters": {"type": "object"},
    "qc_metrics": {"type": "array", "items": {"$ref": "urn:emrys:schema:artifacts:common:v1#/$defs/metric"}},
    "limitations": {"type": "array", "items": {"$ref": "urn:emrys:schema:artifacts:run-summary:v6#/$defs/limitation"}},
    "analysis_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"$ref": "urn:emrys:schema:artifacts:common:v1#/$defs/path"},
        "sha256": {"$ref": "urn:emrys:schema:artifacts:common:v1#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "warnings": {"type": "array", "items": {"$ref": "urn:emrys:schema:artifacts:common:v1#/$defs/issue"}},
    "errors": {"type": "array", "items": {"$ref": "urn:emrys:schema:artifacts:common:v1#/$defs/issue"}},
    "provenance": {"allOf": [
      {"$ref": "urn:emrys:schema:artifacts:common:v1#/$defs/provenance"},
      {"required": ["installed_package"]}
    ]},
    "tables": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "sha256", "size_bytes"],
        "properties": {
          "path": {"$ref": "urn:emrys:schema:artifacts:common:v1#/$defs/path"},
          "sha256": {"$ref": "urn:emrys:schema:artifacts:common:v1#/$defs/sha256"},
          "size_bytes": {"type": "integer", "minimum": 1}
        }
      }
    },
    "scientific_origin": {
      "type": "object", "additionalProperties": false,
      "required": ["run", "attempt"],
      "properties": {
        "run": {"$ref": "#/properties/run_contract_file"},
        "attempt": {"$ref": "#/properties/run_contract_file"}
      }
    },
    "run_contract_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "urn:emrys:schema:artifacts:common:v1#/$defs/path"},
        "sha256": {"$ref": "urn:emrys:schema:artifacts:common:v1#/$defs/sha256"}
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt_id", "started_at", "finished_at", "transaction_state"],
      "properties": {
        "attempt_id": {"$ref": "urn:emrys:schema:artifacts:common:v1#/$defs/safe_id"},
        "started_at": {"type": "string", "format": "date-time"},
        "finished_at": {"type": "string", "format": "date-time"},
        "transaction_state": {"const": "complete"}
      }
    }
  },
  "$defs": {
    "expected_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "artifact_ids",
        "aggregate_state",
        "warnings",
        "errors"
      ],
      "properties": {
        "scope": {"$ref": "urn:emrys:schema:artifacts:common:v1#/$defs/scope"},
        "artifact_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "urn:emrys:schema:artifacts:common:v1#/$defs/safe_id"},
          "uniqueItems": true
        },
        "aggregate_state": {"enum": ["complete", "missing", "incomplete", "failed", "externally_unavailable"]},
        "warnings": {"type": "array", "items": {"$ref": "urn:emrys:schema:artifacts:common:v1#/$defs/issue"}},
        "errors": {"type": "array", "items": {"$ref": "urn:emrys:schema:artifacts:common:v1#/$defs/issue"}}
      }
    },
    "computational_rollup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_artifact_count",
        "complete_artifact_count",
        "missing_artifact_count",
        "incomplete_artifact_count",
        "failed_artifact_count",
        "externally_unavailable_artifact_count"
      ],
      "properties": {
        "expected_artifact_count": {"type": "integer", "minimum": 0},
        "complete_artifact_count": {"type": "integer", "minimum": 0},
        "missing_artifact_count": {"type": "integer", "minimum": 0},
        "incomplete_artifact_count": {"type": "integer", "minimum": 0},
        "failed_artifact_count": {"type": "integer", "minimum": 0},
        "externally_unavailable_artifact_count": {"type": "integer", "minimum": 0}
      }
    },
    "limitation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["limitation_id", "status", "description", "impact", "evidence_ids"],
      "properties": {
        "limitation_id": {"$ref": "urn:emrys:schema:artifacts:common:v1#/$defs/safe_id"},
        "status": {"enum": ["open", "resolved"]},
        "description": {"$ref": "urn:emrys:schema:artifacts:common:v1#/$defs/non_empty_string"},
        "impact": {"$ref": "urn:emrys:schema:artifacts:common:v1#/$defs/non_empty_string"},
        "evidence_ids": {
          "type": "array",
          "items": {"$ref": "urn:emrys:schema:artifacts:common:v1#/$defs/safe_id"},
          "uniqueItems": true
        }
      }
    }
  }
}
