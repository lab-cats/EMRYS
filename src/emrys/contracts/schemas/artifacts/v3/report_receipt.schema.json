{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:emrys:schema:artifacts:report-receipt:v3",
  "title": "EMRYS report receipt v3",
  "description": "The receipt-last contract for one self-contained Jinja HTML report transaction. It reports computational evidence only; biological validation is outside EMRYS.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "record_type",
    "run_id",
    "attempt_id",
    "generated_at",
    "publication_state",
    "transaction_state",
    "interpretation_boundary",
    "input_run_summary",
    "renderer",
    "template",
    "stylesheet",
    "outputs",
    "state_banner",
    "truncations",
    "schema_versions",
    "analysis_execution_performed",
    "external_network_assets_used",
    "validation_claimed",
    "warnings",
    "errors",
    "provenance"
  ],
  "properties": {
    "schema_name": {"const": "emrys.report_receipt"},
    "schema_version": {"const": "3.0.0"},
    "record_type": {"const": "report_receipt"},
    "run_id": {"$ref": "urn:emrys:schema:artifacts:common:v1#/$defs/safe_id"},
    "attempt_id": {"$ref": "urn:emrys:schema:artifacts:common:v1#/$defs/safe_id"},
    "generated_at": {"type": "string", "format": "date-time"},
    "publication_state": {"const": "complete"},
    "transaction_state": {"const": "complete"},
    "interpretation_boundary": {
      "const": "computational_candidates_only_biological_validation_outside_emrys"
    },
    "input_run_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "schema_name", "schema_version"],
      "properties": {
        "path": {"$ref": "urn:emrys:schema:artifacts:common:v1#/$defs/path"},
        "sha256": {"$ref": "urn:emrys:schema:artifacts:common:v1#/$defs/sha256"},
        "schema_name": {"const": "emrys.run_summary"},
        "schema_version": {"const": "2.0.0"}
      }
    },
    "renderer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "Jinja2"},
        "version": {"const": "3.1.6"}
      }
    },
    "template": {"$ref": "#/$defs/resource"},
    "stylesheet": {"$ref": "#/$defs/resource"},
    "outputs": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/report_output"}
    },
    "state_banner": {
      "const": "COMPUTATIONAL RESULTS — BIOLOGICAL VALIDATION IS OUTSIDE EMRYS."
    },
    "truncations": {
      "type": "array",
      "items": {"$ref": "#/$defs/truncation"}
    },
    "schema_versions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_record",
        "run_summary",
        "report_receipt"
      ],
      "properties": {
        "artifact_record": {"const": "2.0.0"},
        "run_summary": {"const": "2.0.0"},
        "report_receipt": {"const": "3.0.0"}
      }
    },
    "analysis_execution_performed": {"const": false},
    "external_network_assets_used": {"const": false},
    "validation_claimed": {"const": false},
    "warnings": {
      "type": "array",
      "items": {"$ref": "urn:emrys:schema:artifacts:common:v1#/$defs/issue"}
    },
    "errors": {
      "type": "array",
      "maxItems": 0,
      "items": {"$ref": "urn:emrys:schema:artifacts:common:v1#/$defs/issue"}
    },
    "provenance": {"$ref": "urn:emrys:schema:artifacts:common:v1#/$defs/provenance"}
  },
  "$defs": {
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "urn:emrys:schema:artifacts:common:v1#/$defs/path"},
        "sha256": {"$ref": "urn:emrys:schema:artifacts:common:v1#/$defs/sha256"}
      }
    },
    "report_output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["output_id", "kind", "path", "sha256", "size_bytes", "media_type"],
      "properties": {
        "output_id": {"$ref": "urn:emrys:schema:artifacts:common:v1#/$defs/safe_id"},
        "kind": {"enum": ["html", "run_summary_tsv"]},
        "path": {"$ref": "urn:emrys:schema:artifacts:common:v1#/$defs/path"},
        "sha256": {"$ref": "urn:emrys:schema:artifacts:common:v1#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "media_type": {"$ref": "urn:emrys:schema:artifacts:common:v1#/$defs/non_empty_string"},
        "self_contained": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "html"}}, "required": ["kind"]},
          "then": {
            "required": ["self_contained"],
            "properties": {
              "media_type": {"const": "text/html"},
              "self_contained": {"const": true}
            }
          }
        },
        {
          "if": {"properties": {"kind": {"const": "run_summary_tsv"}}, "required": ["kind"]},
          "then": {
            "properties": {"media_type": {"const": "text/tab-separated-values"}},
            "not": {"required": ["self_contained"]}
          }
        }
      ]
    },
    "truncation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "table_id",
        "report_section",
        "full_table_path",
        "full_table_sha256",
        "full_row_count",
        "displayed_row_count"
      ],
      "properties": {
        "table_id": {"$ref": "urn:emrys:schema:artifacts:common:v1#/$defs/safe_id"},
        "report_section": {"$ref": "urn:emrys:schema:artifacts:common:v1#/$defs/safe_id"},
        "full_table_path": {"$ref": "urn:emrys:schema:artifacts:common:v1#/$defs/path"},
        "full_table_sha256": {"$ref": "urn:emrys:schema:artifacts:common:v1#/$defs/sha256"},
        "full_row_count": {"type": "integer", "minimum": 1},
        "displayed_row_count": {"type": "integer", "minimum": 0}
      }
    }
  }
}
