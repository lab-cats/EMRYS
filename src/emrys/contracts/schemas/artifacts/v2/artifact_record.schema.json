{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:emrys:schema:artifacts:artifact-entry:v3",
  "title": "EMRYS Run artifact entry",
  "description": "One expected artifact; the containing Run manifest owns shared identity and publication provenance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "scope",
    "adapter",
    "expectation",
    "availability_status",
    "completion_status",
    "state_reason",
    "source",
    "parameters",
    "metrics",
    "warnings",
    "errors"
  ],
  "properties": {
    "artifact_id": {
      "$ref": "urn:emrys:schema:artifacts:common:v1#/$defs/safe_id"
    },
    "scope": {
      "$ref": "urn:emrys:schema:artifacts:common:v1#/$defs/scope"
    },
    "adapter": {
      "$ref": "urn:emrys:schema:artifacts:common:v1#/$defs/safe_id"
    },
    "expectation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "source_path"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "source_path": {
          "$ref": "urn:emrys:schema:artifacts:common:v1#/$defs/path"
        }
      }
    },
    "availability_status": {
      "enum": [
        "present",
        "missing",
        "externally_unavailable",
        "unknown"
      ]
    },
    "completion_status": {
      "enum": [
        "not_attempted",
        "in_progress",
        "complete",
        "incomplete",
        "failed"
      ]
    },
    "state_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "source": {
      "oneOf": [
        {
          "$ref": "urn:emrys:schema:artifacts:common:v1#/$defs/path_hash"
        },
        {
          "type": "null"
        }
      ]
    },
    "parameters": {
      "type": "object"
    },
    "metrics": {
      "type": "array",
      "items": {
        "$ref": "urn:emrys:schema:artifacts:common:v1#/$defs/metric"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "urn:emrys:schema:artifacts:common:v1#/$defs/issue"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "urn:emrys:schema:artifacts:common:v1#/$defs/issue"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "availability_status": {
            "const": "present"
          }
        },
        "required": [
          "availability_status"
        ]
      },
      "then": {
        "properties": {
          "source": {
            "$ref": "urn:emrys:schema:artifacts:common:v1#/$defs/path_hash"
          }
        }
      },
      "else": {
        "properties": {
          "source": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "completion_status": {
            "const": "complete"
          }
        },
        "required": [
          "completion_status"
        ]
      },
      "then": {
        "properties": {
          "state_reason": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "state_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "completion_status": {
            "const": "complete"
          }
        },
        "required": [
          "completion_status"
        ]
      },
      "then": {
        "properties": {
          "availability_status": {
            "const": "present"
          }
        }
      }
    }
  ]
}
