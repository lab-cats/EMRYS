{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:emrys:schema:artifacts:run-summary:v2",
  "title": "EMRYS run summary v2",
  "description": "The canonical computational summary for one immutable EMRYS run contract. Biological validation and interpretation are outside EMRYS.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "record_type",
    "run_id",
    "run_contract",
    "summary_state",
    "generated_at",
    "inventory",
    "artifact_receipt",
    "attempts",
    "superseded_attempt_ids",
    "expected_scopes",
    "artifacts",
    "computational_rollup",
    "tools",
    "parameters",
    "qc_metrics",
    "limitations",
    "candidate_terminology",
    "interpretation_boundary",
    "warnings",
    "errors",
    "provenance"
  ],
  "properties": {
    "schema_name": {"const": "emrys.run_summary"},
    "schema_version": {"const": "2.0.0"},
    "record_type": {"const": "run_summary"},
    "run_id": {"$ref": "urn:emrys:schema:artifacts:common:v1#/$defs/safe_id"},
    "run_contract": {"$ref": "urn:emrys:schema:artifacts:common:v1#/$defs/run_contract"},
    "summary_state": {"enum": ["complete", "incomplete", "failed"]},
    "generated_at": {"type": "string", "format": "date-time"},
    "inventory": {"$ref": "urn:emrys:schema:artifacts:common:v1#/$defs/path_hash"},
    "artifact_receipt": {"$ref": "urn:emrys:schema:artifacts:common:v1#/$defs/path_hash"},
    "attempts": {
      "type": "array",
      "items": {"$ref": "urn:emrys:schema:artifacts:common:v1#/$defs/attempt"}
    },
    "superseded_attempt_ids": {
      "type": "array",
      "items": {"$ref": "urn:emrys:schema:artifacts:common:v1#/$defs/safe_id"},
      "uniqueItems": true
    },
    "expected_scopes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/expected_scope"}
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "urn:emrys:schema:artifacts:artifact-record:v2"}
    },
    "computational_rollup": {"$ref": "#/$defs/computational_rollup"},
    "tools": {
      "type": "array",
      "items": {"$ref": "urn:emrys:schema:artifacts:common:v1#/$defs/tool"}
    },
    "parameters": {"type": "object"},
    "qc_metrics": {
      "type": "array",
      "items": {"$ref": "urn:emrys:schema:artifacts:common:v1#/$defs/metric"}
    },
    "limitations": {
      "type": "array",
      "items": {"$ref": "#/$defs/limitation"}
    },
    "candidate_terminology": {"const": "CMH-ranked candidates"},
    "interpretation_boundary": {
      "const": "computational_candidates_only_biological_validation_outside_emrys"
    },
    "warnings": {
      "type": "array",
      "items": {"$ref": "urn:emrys:schema:artifacts:common:v1#/$defs/issue"}
    },
    "errors": {
      "type": "array",
      "items": {"$ref": "urn:emrys:schema:artifacts:common:v1#/$defs/issue"}
    },
    "provenance": {"$ref": "urn:emrys:schema:artifacts:common:v1#/$defs/provenance"}
  },
  "$defs": {
    "expected_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "artifact_ids",
        "aggregate_state",
        "implementation_status",
        "local_test_status",
        "runtime_validation_status",
        "cluster_dry_run_status",
        "cluster_proof_status",
        "warnings",
        "errors"
      ],
      "properties": {
        "scope": {"$ref": "urn:emrys:schema:artifacts:common:v1#/$defs/scope"},
        "artifact_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "urn:emrys:schema:artifacts:common:v1#/$defs/safe_id"},
          "uniqueItems": true
        },
        "aggregate_state": {
          "enum": ["complete", "missing", "incomplete", "failed", "externally_unavailable"]
        },
        "implementation_status": {"enum": ["not_implemented", "implemented", "mixed"]},
        "local_test_status": {"enum": ["not_run", "passed", "failed", "mixed"]},
        "runtime_validation_status": {"enum": ["not_run", "blocked", "passed", "failed", "mixed"]},
        "cluster_dry_run_status": {"enum": ["not_run", "passed", "failed", "mixed"]},
        "cluster_proof_status": {"enum": ["not_run", "proven", "failed", "mixed"]},
        "warnings": {
          "type": "array",
          "items": {"$ref": "urn:emrys:schema:artifacts:common:v1#/$defs/issue"}
        },
        "errors": {
          "type": "array",
          "items": {"$ref": "urn:emrys:schema:artifacts:common:v1#/$defs/issue"}
        }
      }
    },
    "computational_rollup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_artifact_count",
        "complete_artifact_count",
        "missing_artifact_count",
        "incomplete_artifact_count",
        "failed_artifact_count",
        "externally_unavailable_artifact_count",
        "implementation_status",
        "local_test_status",
        "runtime_validation_status",
        "cluster_dry_run_status",
        "cluster_proof_status"
      ],
      "properties": {
        "expected_artifact_count": {"type": "integer", "minimum": 0},
        "complete_artifact_count": {"type": "integer", "minimum": 0},
        "missing_artifact_count": {"type": "integer", "minimum": 0},
        "incomplete_artifact_count": {"type": "integer", "minimum": 0},
        "failed_artifact_count": {"type": "integer", "minimum": 0},
        "externally_unavailable_artifact_count": {"type": "integer", "minimum": 0},
        "implementation_status": {"enum": ["not_implemented", "implemented", "mixed"]},
        "local_test_status": {"enum": ["not_run", "passed", "failed", "mixed"]},
        "runtime_validation_status": {"enum": ["not_run", "blocked", "passed", "failed", "mixed"]},
        "cluster_dry_run_status": {"enum": ["not_run", "passed", "failed", "mixed"]},
        "cluster_proof_status": {"enum": ["not_run", "proven", "failed", "mixed"]}
      }
    },
    "limitation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["limitation_id", "status", "description", "impact", "evidence_ids"],
      "properties": {
        "limitation_id": {"$ref": "urn:emrys:schema:artifacts:common:v1#/$defs/safe_id"},
        "status": {"enum": ["open", "resolved"]},
        "description": {"$ref": "urn:emrys:schema:artifacts:common:v1#/$defs/non_empty_string"},
        "impact": {"$ref": "urn:emrys:schema:artifacts:common:v1#/$defs/non_empty_string"},
        "evidence_ids": {
          "type": "array",
          "items": {"$ref": "urn:emrys:schema:artifacts:common:v1#/$defs/safe_id"},
          "uniqueItems": true
        }
      }
    }
  }
}
