{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:norad:schema:artifacts:common:v1",
  "title": "NORAD artifact common definitions v1",
  "description": "Shared definitions for the NORAD artifact-schema-v1 record contracts.",
  "$defs": {
    "safe_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\s)(?!.*\\s$)(?!.*//)(?!.*\\$\\{)(?!.*\\{\\{)(?!.*\\}\\})(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$))[^*?\\[\\]\\u0000\\r\\n]+$"
    },
    "git_commit": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "evidence_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "role",
        "path",
        "sha256"
      ],
      "properties": {
        "evidence_id": {
          "$ref": "#/$defs/safe_id"
        },
        "role": {
          "enum": [
            "implementation",
            "local_test",
            "runtime_log",
            "runtime_output",
            "cluster_dry_run",
            "cluster_scheduler",
            "cluster_log",
            "cluster_output",
            "scientific_evidence",
            "validation_record",
            "receipt",
            "source_manifest"
          ]
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "path_hash": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "row_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "media_type": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "related_artifact_ids",
        "evidence"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/safe_id"
        },
        "message": {
          "$ref": "#/$defs/non_empty_string"
        },
        "related_artifact_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/safe_id"
          },
          "uniqueItems": true
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_reference"
          }
        }
      }
    },
    "limitation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "limitation_id",
        "status",
        "description",
        "impact",
        "evidence_ids"
      ],
      "properties": {
        "limitation_id": {
          "$ref": "#/$defs/safe_id"
        },
        "status": {
          "enum": [
            "open",
            "accepted",
            "resolved"
          ]
        },
        "description": {
          "$ref": "#/$defs/non_empty_string"
        },
        "impact": {
          "$ref": "#/$defs/non_empty_string"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/safe_id"
          },
          "uniqueItems": true
        }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "role",
        "path",
        "sha256"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/safe_id"
        },
        "version": {
          "$ref": "#/$defs/non_empty_string"
        },
        "role": {
          "$ref": "#/$defs/non_empty_string"
        },
        "path": {
          "oneOf": [
            {
              "$ref": "#/$defs/path"
            },
            {
              "type": "null"
            }
          ]
        },
        "sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric_id",
        "name",
        "value",
        "unit",
        "status",
        "source_artifact_id"
      ],
      "properties": {
        "metric_id": {
          "$ref": "#/$defs/safe_id"
        },
        "name": {
          "$ref": "#/$defs/non_empty_string"
        },
        "value": {
          "type": [
            "number",
            "integer",
            "string",
            "boolean",
            "null"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "pass",
            "flag",
            "fail",
            "not_assessed"
          ]
        },
        "source_artifact_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/safe_id"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer",
        "producer_version",
        "git_commit",
        "created_at"
      ],
      "properties": {
        "producer": {
          "$ref": "#/$defs/safe_id"
        },
        "producer_version": {
          "$ref": "#/$defs/non_empty_string"
        },
        "git_commit": {
          "$ref": "#/$defs/git_commit"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "run_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_contract_sha256",
        "sample_manifest_sha256",
        "reference_contract_sha256",
        "partition_manifest_sha256",
        "primary_analysis_id",
        "primary_analysis_policy_sha256"
      ],
      "properties": {
        "run_contract_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "sample_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "reference_contract_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "partition_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "primary_analysis_id": {
          "$ref": "#/$defs/safe_id"
        },
        "primary_analysis_policy_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_id",
        "scope_type",
        "scope_id"
      ],
      "properties": {
        "step_id": {
          "$ref": "#/$defs/safe_id"
        },
        "scope_type": {
          "$ref": "#/$defs/safe_id"
        },
        "scope_id": {
          "$ref": "#/$defs/safe_id"
        }
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_id",
        "state",
        "started_at",
        "finished_at",
        "exit_code",
        "supersedes_attempt_id",
        "evidence",
        "warnings",
        "errors"
      ],
      "properties": {
        "attempt_id": {
          "$ref": "#/$defs/safe_id"
        },
        "state": {
          "enum": [
            "planned",
            "running",
            "succeeded",
            "failed",
            "cancelled",
            "blocked"
          ]
        },
        "started_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "finished_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "supersedes_attempt_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/safe_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_reference"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/issue"
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/issue"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "planned"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "started_at": {
                "type": "null"
              },
              "finished_at": {
                "type": "null"
              },
              "exit_code": {
                "type": "null"
              },
              "errors": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "running"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "started_at": {
                "type": "string",
                "format": "date-time"
              },
              "finished_at": {
                "type": "null"
              },
              "exit_code": {
                "type": "null"
              },
              "errors": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "succeeded"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "started_at": {
                "type": "string",
                "format": "date-time"
              },
              "finished_at": {
                "type": "string",
                "format": "date-time"
              },
              "exit_code": {
                "const": 0
              },
              "errors": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "failed"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "started_at": {
                "type": "string",
                "format": "date-time"
              },
              "finished_at": {
                "type": "string",
                "format": "date-time"
              },
              "exit_code": {
                "type": "integer",
                "not": {
                  "const": 0
                }
              },
              "errors": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "cancelled",
                  "blocked"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "finished_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      ]
    }
  }
}
