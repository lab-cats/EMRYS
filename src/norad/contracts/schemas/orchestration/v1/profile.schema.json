{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:norad:schema:orchestration:profile:v1",
  "title": "NORAD fixed local CMH profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "profile_version",
    "semantic_owner_keys",
    "owner_tasks",
    "direct_edges",
    "required_owner_keys",
    "evidence_owner_keys",
    "excluded_owner_keys",
    "artifact_templates"
  ],
  "properties": {
    "schema_version": {
      "const": "norad.profile.v1"
    },
    "profile_id": {
      "const": "norad.profile.local_cmh"
    },
    "profile_version": {
      "const": "v1"
    },
    "semantic_owner_keys": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "urn:norad:schema:orchestration:common:v1#/$defs/safe_id"
      }
    },
    "owner_tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "machine_key",
          "rule_name",
          "step_id",
          "scope_type",
          "scope_selector"
        ],
        "properties": {
          "machine_key": {
            "$ref": "urn:norad:schema:orchestration:common:v1#/$defs/safe_id"
          },
          "rule_name": {
            "$ref": "urn:norad:schema:orchestration:common:v1#/$defs/safe_id"
          },
          "step_id": {
            "$ref": "urn:norad:schema:orchestration:common:v1#/$defs/safe_id"
          },
          "scope_type": {
            "enum": [
              "reference",
              "sample",
              "cohort_partition",
              "cohort",
              "analysis",
              "scientific_review"
            ]
          },
          "scope_selector": {
            "enum": [
              "reference",
              "samples",
              "partitions",
              "cohort",
              "analysis",
              "scientific_review"
            ]
          }
        }
      }
    },
    "direct_edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "producer",
          "consumer",
          "artifact",
          "semantics"
        ],
        "properties": {
          "producer": {
            "$ref": "urn:norad:schema:orchestration:common:v1#/$defs/safe_id"
          },
          "consumer": {
            "$ref": "urn:norad:schema:orchestration:common:v1#/$defs/safe_id"
          },
          "artifact": {
            "$ref": "urn:norad:schema:orchestration:common:v1#/$defs/non_empty_string"
          },
          "semantics": {
            "$ref": "urn:norad:schema:orchestration:common:v1#/$defs/non_empty_string"
          }
        }
      }
    },
    "required_owner_keys": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "urn:norad:schema:orchestration:common:v1#/$defs/safe_id"
      }
    },
    "evidence_owner_keys": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "urn:norad:schema:orchestration:common:v1#/$defs/safe_id"
      }
    },
    "excluded_owner_keys": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "urn:norad:schema:orchestration:common:v1#/$defs/safe_id"
      }
    },
    "artifact_templates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id_template",
          "step_id",
          "scope_type",
          "scope_selector",
          "adapter",
          "source_path_template",
          "required"
        ],
        "properties": {
          "artifact_id_template": {
            "$ref": "urn:norad:schema:orchestration:common:v1#/$defs/non_empty_string"
          },
          "step_id": {
            "$ref": "urn:norad:schema:orchestration:common:v1#/$defs/safe_id"
          },
          "scope_type": {
            "enum": [
              "reference",
              "sample",
              "cohort_partition",
              "cohort",
              "analysis",
              "scientific_review"
            ]
          },
          "scope_selector": {
            "enum": [
              "reference",
              "samples",
              "partitions",
              "cohort",
              "analysis",
              "scientific_review"
            ]
          },
          "adapter": {
            "$ref": "urn:norad:schema:orchestration:common:v1#/$defs/safe_id"
          },
          "source_path_template": {
            "$ref": "urn:norad:schema:orchestration:common:v1#/$defs/non_empty_string"
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
