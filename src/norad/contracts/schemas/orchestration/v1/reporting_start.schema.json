{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:norad:schema:orchestration:reporting-start:v1",
  "title": "NORAD reporting producer start marker v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "execution_contract_sha256",
    "profile_sha256",
    "origin_workflow_attempt_id",
    "kind",
    "workflow_attempt",
    "workflow_config",
    "run_lock",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "norad.reporting-start.v1"
    },
    "run_id": {
      "$ref": "urn:norad:schema:orchestration:common:v1#/$defs/run_id"
    },
    "execution_contract_sha256": {
      "$ref": "urn:norad:schema:orchestration:common:v1#/$defs/sha256"
    },
    "profile_sha256": {
      "$ref": "urn:norad:schema:orchestration:common:v1#/$defs/sha256"
    },
    "origin_workflow_attempt_id": {
      "$ref": "urn:norad:schema:orchestration:common:v1#/$defs/workflow_attempt_id"
    },
    "kind": {
      "enum": [
        "artifact_index",
        "run_summary",
        "html_report"
      ]
    },
    "workflow_attempt": {
      "$ref": "urn:norad:schema:orchestration:common:v1#/$defs/record_reference"
    },
    "workflow_config": {
      "$ref": "urn:norad:schema:orchestration:common:v1#/$defs/record_reference"
    },
    "run_lock": {
      "$ref": "urn:norad:schema:orchestration:common:v1#/$defs/record_reference"
    },
    "created_at": {
      "$ref": "urn:norad:schema:orchestration:common:v1#/$defs/timestamp"
    }
  }
}
