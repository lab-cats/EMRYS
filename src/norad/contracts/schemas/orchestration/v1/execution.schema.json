{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:norad:schema:orchestration:execution:v1",
  "title": "NORAD normalized execution contract v1",
  "$defs": {
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cohort_id",
        "primary_analysis_id",
        "policy",
        "policy_sha256"
      ],
      "properties": {
        "cohort_id": {
          "$ref": "urn:norad:schema:orchestration:common:v1#/$defs/safe_id"
        },
        "primary_analysis_id": {
          "$ref": "urn:norad:schema:orchestration:common:v1#/$defs/safe_id"
        },
        "policy": {
          "$ref": "urn:norad:schema:orchestration:policy:v1"
        },
        "policy_sha256": {
          "$ref": "urn:norad:schema:orchestration:common:v1#/$defs/sha256"
        }
      }
    },
    "identity_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "profile",
        "samples",
        "partitions",
        "reference",
        "analysis"
      ],
      "properties": {
        "schema_version": {
          "const": "norad.identity-envelope.v1"
        },
        "profile": {
          "$ref": "urn:norad:schema:orchestration:common:v1#/$defs/profile_identity"
        },
        "samples": {
          "$ref": "urn:norad:schema:orchestration:common:v1#/$defs/sample_set"
        },
        "partitions": {
          "$ref": "urn:norad:schema:orchestration:common:v1#/$defs/partition_set"
        },
        "reference": {
          "$ref": "urn:norad:schema:orchestration:reference:v1"
        },
        "analysis": {
          "$ref": "#/$defs/analysis"
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile",
    "samples",
    "partitions",
    "reference",
    "analysis",
    "identity_envelope",
    "identity_envelope_sha256",
    "run_id",
    "reporting_projection"
  ],
  "properties": {
    "schema_version": {
      "const": "norad.execution.v1"
    },
    "profile": {
      "$ref": "urn:norad:schema:orchestration:common:v1#/$defs/profile_identity"
    },
    "samples": {
      "$ref": "urn:norad:schema:orchestration:common:v1#/$defs/sample_set"
    },
    "partitions": {
      "$ref": "urn:norad:schema:orchestration:common:v1#/$defs/partition_set"
    },
    "reference": {
      "$ref": "urn:norad:schema:orchestration:reference:v1"
    },
    "analysis": {
      "$ref": "#/$defs/analysis"
    },
    "identity_envelope": {
      "$ref": "#/$defs/identity_envelope"
    },
    "identity_envelope_sha256": {
      "$ref": "urn:norad:schema:orchestration:common:v1#/$defs/sha256"
    },
    "run_id": {
      "$ref": "urn:norad:schema:orchestration:common:v1#/$defs/run_id"
    },
    "reporting_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_contract",
        "primary_analysis_policy",
        "reporting_run_contract",
        "artifact_inventory"
      ],
      "properties": {
        "reference_contract": {
          "allOf": [
            {
              "$ref": "urn:norad:schema:orchestration:common:v1#/$defs/record_reference"
            },
            {
              "properties": {
                "path": {
                  "const": "contract/reference_contract.json"
                }
              }
            }
          ]
        },
        "primary_analysis_policy": {
          "allOf": [
            {
              "$ref": "urn:norad:schema:orchestration:common:v1#/$defs/record_reference"
            },
            {
              "properties": {
                "path": {
                  "const": "contract/primary_analysis_policy.json"
                }
              }
            }
          ]
        },
        "reporting_run_contract": {
          "allOf": [
            {
              "$ref": "urn:norad:schema:orchestration:common:v1#/$defs/record_reference"
            },
            {
              "properties": {
                "path": {
                  "const": "contract/reporting_run_contract.json"
                }
              }
            }
          ]
        },
        "artifact_inventory": {
          "allOf": [
            {
              "$ref": "urn:norad:schema:orchestration:common:v1#/$defs/record_reference"
            },
            {
              "properties": {
                "path": {
                  "const": "contract/artifact_inventory.tsv"
                }
              }
            }
          ]
        }
      }
    }
  }
}
