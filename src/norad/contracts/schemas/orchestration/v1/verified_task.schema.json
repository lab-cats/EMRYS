{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:norad:schema:orchestration:verified-task:v1",
  "title": "NORAD verified reusable task record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "execution_contract_sha256",
    "profile_sha256",
    "workflow_attempt_id",
    "task_attempt_id",
    "task_attempt_record",
    "task_start_record",
    "machine_key",
    "scope",
    "owner_run_token",
    "commands",
    "inputs",
    "outputs",
    "native_receipt",
    "validation_report",
    "stable_inputs_rechecked",
    "all_pass",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "norad.verified-task.v1"
    },
    "run_id": {
      "$ref": "urn:norad:schema:orchestration:common:v1#/$defs/run_id"
    },
    "execution_contract_sha256": {
      "$ref": "urn:norad:schema:orchestration:common:v1#/$defs/sha256"
    },
    "profile_sha256": {
      "$ref": "urn:norad:schema:orchestration:common:v1#/$defs/sha256"
    },
    "workflow_attempt_id": {
      "$ref": "urn:norad:schema:orchestration:common:v1#/$defs/workflow_attempt_id"
    },
    "task_attempt_id": {
      "$ref": "urn:norad:schema:orchestration:common:v1#/$defs/task_attempt_id"
    },
    "task_attempt_record": {
      "$ref": "urn:norad:schema:orchestration:common:v1#/$defs/record_reference"
    },
    "task_start_record": {
      "$ref": "urn:norad:schema:orchestration:common:v1#/$defs/record_reference"
    },
    "machine_key": {
      "$ref": "urn:norad:schema:orchestration:common:v1#/$defs/safe_id"
    },
    "scope": {
      "$ref": "urn:norad:schema:orchestration:common:v1#/$defs/scope"
    },
    "owner_run_token": {
      "$ref": "urn:norad:schema:orchestration:common:v1#/$defs/safe_id"
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer",
        "validator",
        "semantic_all_pass"
      ],
      "properties": {
        "producer": {
          "$ref": "urn:norad:schema:orchestration:common:v1#/$defs/successful_command"
        },
        "validator": {
          "$ref": "urn:norad:schema:orchestration:common:v1#/$defs/successful_command"
        },
        "semantic_all_pass": {
          "$ref": "urn:norad:schema:orchestration:common:v1#/$defs/successful_command"
        }
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "urn:norad:schema:orchestration:common:v1#/$defs/bound_file"
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "urn:norad:schema:orchestration:common:v1#/$defs/bound_file"
      }
    },
    "native_receipt": {
      "oneOf": [
        {
          "$ref": "urn:norad:schema:orchestration:common:v1#/$defs/record_reference"
        },
        {
          "type": "null"
        }
      ]
    },
    "validation_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "all_pass"
      ],
      "properties": {
        "path": {
          "$ref": "urn:norad:schema:orchestration:common:v1#/$defs/relative_contract_path"
        },
        "sha256": {
          "$ref": "urn:norad:schema:orchestration:common:v1#/$defs/sha256"
        },
        "all_pass": {
          "const": true
        }
      }
    },
    "stable_inputs_rechecked": {
      "const": true
    },
    "all_pass": {
      "const": true
    },
    "created_at": {
      "$ref": "urn:norad:schema:orchestration:common:v1#/$defs/timestamp"
    }
  }
}
