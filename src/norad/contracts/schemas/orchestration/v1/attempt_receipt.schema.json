{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:norad:schema:orchestration:attempt-receipt:v1",
  "title": "NORAD terminal workflow attempt receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "execution_contract_sha256",
    "profile_sha256",
    "workflow_attempt_id",
    "attempt_record",
    "status",
    "finished_at",
    "verified_tasks",
    "reporting_records",
    "blockers",
    "message",
    "local_pipeline_complete"
  ],
  "properties": {
    "schema_version": {
      "const": "norad.attempt-receipt.v1"
    },
    "run_id": {
      "$ref": "urn:norad:schema:orchestration:common:v1#/$defs/run_id"
    },
    "execution_contract_sha256": {
      "$ref": "urn:norad:schema:orchestration:common:v1#/$defs/sha256"
    },
    "profile_sha256": {
      "$ref": "urn:norad:schema:orchestration:common:v1#/$defs/sha256"
    },
    "workflow_attempt_id": {
      "$ref": "urn:norad:schema:orchestration:common:v1#/$defs/workflow_attempt_id"
    },
    "attempt_record": {
      "$ref": "urn:norad:schema:orchestration:common:v1#/$defs/record_reference"
    },
    "status": {
      "enum": [
        "succeeded",
        "failed",
        "interrupted",
        "blocked"
      ]
    },
    "finished_at": {
      "$ref": "urn:norad:schema:orchestration:common:v1#/$defs/timestamp"
    },
    "verified_tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "machine_key",
          "scope",
          "record"
        ],
        "properties": {
          "machine_key": {
            "$ref": "urn:norad:schema:orchestration:common:v1#/$defs/safe_id"
          },
          "scope": {
            "$ref": "urn:norad:schema:orchestration:common:v1#/$defs/scope"
          },
          "record": {
            "$ref": "urn:norad:schema:orchestration:common:v1#/$defs/record_reference"
          }
        }
      }
    },
    "reporting_records": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_index",
        "run_summary",
        "html_report"
      ],
      "properties": {
        "artifact_index": {
          "oneOf": [
            {
              "$ref": "urn:norad:schema:orchestration:common:v1#/$defs/record_reference"
            },
            {
              "type": "null"
            }
          ]
        },
        "run_summary": {
          "oneOf": [
            {
              "$ref": "urn:norad:schema:orchestration:common:v1#/$defs/record_reference"
            },
            {
              "type": "null"
            }
          ]
        },
        "html_report": {
          "oneOf": [
            {
              "$ref": "urn:norad:schema:orchestration:common:v1#/$defs/record_reference"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "$ref": "urn:norad:schema:orchestration:common:v1#/$defs/non_empty_string"
      }
    },
    "message": {
      "oneOf": [
        {
          "$ref": "urn:norad:schema:orchestration:common:v1#/$defs/non_empty_string"
        },
        {
          "type": "null"
        }
      ]
    },
    "local_pipeline_complete": {
      "type": "boolean"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "succeeded"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "verified_tasks": {
            "minItems": 1
          },
          "reporting_records": {
            "properties": {
              "artifact_index": {
                "$ref": "urn:norad:schema:orchestration:common:v1#/$defs/record_reference"
              },
              "run_summary": {
                "$ref": "urn:norad:schema:orchestration:common:v1#/$defs/record_reference"
              },
              "html_report": {
                "$ref": "urn:norad:schema:orchestration:common:v1#/$defs/record_reference"
              }
            }
          },
          "blockers": {
            "maxItems": 0
          },
          "local_pipeline_complete": {
            "const": true
          }
        }
      },
      "else": {
        "properties": {
          "local_pipeline_complete": {
            "const": false
          }
        }
      }
    }
  ]
}
