"""Static processing and selected-analysis projection of EMRYS's owner graph."""

from __future__ import annotations

import hashlib
import re
import sys
from pathlib import Path

import emrys
from emrys.contracts.orchestration import api as orchestration_contracts
from emrys.contracts.orchestration.application_model import (
    functional_specification_from_profile,
    processing_stopping_owner_keys,
)
from emrys.libraries.source_authority import (
    SourceCheckoutError,
    attest_source_checkout,
    require_controlled_python_runtime,
)
from emrys.orchestration.local_pilot.task import (
    TaskBoundaryError,
    validate_verified_task,
)
from emrys.orchestration.local_pilot.inspection import (
    admit_execution_path,
    expected_tasks,
    state_tree_blockers,
    task_start_tree_blockers,
    verified_tree_blockers,
)

try:
    require_controlled_python_runtime()
except SourceCheckoutError as exc:
    raise WorkflowError(f"Uncontrolled workflow Python runtime: {exc}") from exc


WORKFLOW_ROOT = Path(workflow.basedir).resolve()
CONFIG_KEYS = {
    "run_root",
    "python_executable",
    "execution_path",
    "profile_path",
    "workflow_attempt_id",
    "source_checkout",
    "reference_contract_path",
    "primary_analysis_policy_path",
    "reporting_run_contract_path",
    "artifact_inventory_path",
    "resource_policy",
    "dispatch_paths",
}
if set(config) != CONFIG_KEYS:
    raise WorkflowError(
        "Workflow config keys must be exactly " + ", ".join(sorted(CONFIG_KEYS))
    )


def _absolute_config_path(key):
    value = config.get(key)
    if not isinstance(value, str) or not value:
        raise WorkflowError(f"Workflow config {key!r} must be a nonempty string")
    path = Path(value)
    if not path.is_absolute():
        raise WorkflowError(f"Workflow config {key!r} must be absolute: {value}")
    return path


RUN_ROOT = _absolute_config_path("run_root")
CONFIGURED_PYTHON = _absolute_config_path("python_executable")
EXECUTION_PATH = _absolute_config_path("execution_path")
PROFILE_SNAPSHOT_PATH = _absolute_config_path("profile_path")
SOURCE_CHECKOUT = _absolute_config_path("source_checkout")
STAGE_IDS = {
    "00a", "00b", "00c", "01", "02", "02b", "03", "04", "05", "06",
    "07", "08", "09", "10",
}
REPEATABLE_STAGE_IDS = {"01", "02", "02b", "03", "04", "05", "06", "07"}
HISTORICAL_THREAD_CAPABLE_STEP_IDS = {"00a", "01", "02", "06", "08"}
THREAD_CAPABLE_STEP_IDS = HISTORICAL_THREAD_CAPABLE_STEP_IDS | {"09", "10"}
RESOURCE_POLICY = config.get("resource_policy")
RESOURCE_POLICY_KEYS = {
    "effective", "effective_sha256", "allocation", "sources",
}
if not isinstance(RESOURCE_POLICY, dict) or frozenset(RESOURCE_POLICY) not in {
    frozenset(RESOURCE_POLICY_KEYS),
    frozenset(RESOURCE_POLICY_KEYS | {"symbolic", "symbolic_sha256"}),
}:
    raise WorkflowError("Workflow config resource_policy is malformed")
EFFECTIVE_RESOURCES = RESOURCE_POLICY.get("effective")
orchestration_contracts.validate_record("resource-config", EFFECTIVE_RESOURCES)
if orchestration_contracts.canonical_sha256(EFFECTIVE_RESOURCES) != RESOURCE_POLICY.get(
    "effective_sha256"
):
    raise WorkflowError("Workflow config effective resource digest differs")
WORKFLOW_CORES = EFFECTIVE_RESOURCES.get("workflow_cores")
WORKFLOW_MEMORY_MB = EFFECTIVE_RESOURCES.get("workflow_memory_mb")
for key, value in {
    "workflow_cores": WORKFLOW_CORES,
    "workflow_memory_mb": WORKFLOW_MEMORY_MB,
}.items():
    if isinstance(value, bool) or not isinstance(value, int) or value < 1:
        raise WorkflowError(f"Effective resource {key!r} must be a positive integer")
STEP_THREADS = EFFECTIVE_RESOURCES.get("step_threads")
if (
    not isinstance(STEP_THREADS, dict)
    or not HISTORICAL_THREAD_CAPABLE_STEP_IDS
    <= set(STEP_THREADS)
    <= THREAD_CAPABLE_STEP_IDS
):
    raise WorkflowError(
        "Workflow config step_threads keys must include "
        + ", ".join(sorted(HISTORICAL_THREAD_CAPABLE_STEP_IDS))
        + "; optional keys: 09, 10"
    )
for step_id, value in STEP_THREADS.items():
    if isinstance(value, bool) or not isinstance(value, int) or value < 1:
        raise WorkflowError(
            f"Workflow config step_threads[{step_id!r}] must be a positive integer"
        )
STAGE_CONCURRENCY = EFFECTIVE_RESOURCES.get("stage_concurrency")
if not isinstance(STAGE_CONCURRENCY, dict) or set(STAGE_CONCURRENCY) != REPEATABLE_STAGE_IDS:
    raise WorkflowError(
        "Workflow config stage_concurrency keys must be exactly "
        + ", ".join(sorted(REPEATABLE_STAGE_IDS))
    )
STAGE_MEMORY_MB = EFFECTIVE_RESOURCES.get("stage_memory_mb")
if not isinstance(STAGE_MEMORY_MB, dict) or set(STAGE_MEMORY_MB) != STAGE_IDS:
    raise WorkflowError(
        "Workflow config stage_memory_mb keys must be exactly "
        + ", ".join(sorted(STAGE_IDS))
    )
for field, values in (
    ("stage_concurrency", STAGE_CONCURRENCY),
    ("stage_memory_mb", STAGE_MEMORY_MB),
):
    for key, value in values.items():
        if isinstance(value, bool) or not isinstance(value, int) or value < 1:
            raise WorkflowError(
                f"Workflow config {field}[{key!r}] must be a positive integer"
            )
for step_id in STAGE_IDS:
    concurrency = STAGE_CONCURRENCY.get(step_id, 1)
    threads = STEP_THREADS.get(step_id, 1)
    if concurrency * threads > WORKFLOW_CORES:
        raise WorkflowError(
            f"Stage {step_id} concurrency x threads exceeds workflow cores"
        )
    if concurrency * STAGE_MEMORY_MB[step_id] > WORKFLOW_MEMORY_MB:
        raise WorkflowError(
            f"Stage {step_id} concurrency x memory exceeds workflow memory"
        )
WORKFLOW_ATTEMPT_ID = config.get("workflow_attempt_id")
if not isinstance(WORKFLOW_ATTEMPT_ID, str) or re.fullmatch(
    r"workflow-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{32}", WORKFLOW_ATTEMPT_ID
) is None:
    raise WorkflowError("workflow_attempt_id is not one valid immutable attempt ID")
WORKFLOW_ATTEMPT_PATH = (
    RUN_ROOT / "attempts" / WORKFLOW_ATTEMPT_ID / "attempt.json"
)
PROFILE = orchestration_contracts.load_json_object(PROFILE_SNAPSHOT_PATH)
orchestration_contracts.validate_record("profile", PROFILE)
if PROFILE_SNAPSHOT_PATH.read_bytes() != orchestration_contracts.canonical_json_bytes(
    PROFILE
):
    raise WorkflowError("Run profile snapshot must use canonical JSON bytes")
if not SOURCE_CHECKOUT.is_dir() or SOURCE_CHECKOUT.is_symlink():
    raise WorkflowError(f"source_checkout must be a real directory: {SOURCE_CHECKOUT}")
EXECUTION, _EXECUTION_DATA, SUCCESSOR_AUTHORITY = admit_execution_path(
    EXECUTION_PATH, RUN_ROOT, PROFILE
)
EXPECTED_EXECUTION_PATH = RUN_ROOT / "contract" / (
    "run.json" if SUCCESSOR_AUTHORITY is not None else "normalized.json"
)
if EXECUTION_PATH != EXPECTED_EXECUTION_PATH:
    raise WorkflowError("execution_path does not match the admitted Run format")


def _require_run_file(path, label):
    try:
        path.relative_to(RUN_ROOT)
    except ValueError as exc:
        raise WorkflowError(f"{label} must be beneath run_root: {path}") from exc
    if path.is_symlink() or not path.is_file() or path.resolve(strict=True) != path:
        raise WorkflowError(f"{label} must be an absolute canonical file: {path}")


_require_run_file(EXECUTION_PATH, "execution_path")
_require_run_file(PROFILE_SNAPSHOT_PATH, "profile_path")
_require_run_file(WORKFLOW_ATTEMPT_PATH, "workflow_attempt_path")

WORKFLOW_ATTEMPT = orchestration_contracts.load_json_object(WORKFLOW_ATTEMPT_PATH)
orchestration_contracts.validate_record("workflow-attempt", WORKFLOW_ATTEMPT)
if WORKFLOW_ATTEMPT["workflow_attempt_id"] != WORKFLOW_ATTEMPT_ID:
    raise WorkflowError("workflow attempt record does not match workflow_attempt_id")
WORKFLOW_CONFIG_PATH = RUN_ROOT / WORKFLOW_ATTEMPT["workflow_config"]["path"]
_require_run_file(WORKFLOW_CONFIG_PATH, "workflow config snapshot")
WORKFLOW_CONFIG_BYTES = WORKFLOW_CONFIG_PATH.read_bytes()
if WORKFLOW_CONFIG_BYTES != orchestration_contracts.canonical_json_bytes(dict(config)):
    raise WorkflowError("Workflow config snapshot must use exact canonical JSON bytes")
if WORKFLOW_ATTEMPT["workflow_config"] != {
    "path": WORKFLOW_CONFIG_PATH.relative_to(RUN_ROOT).as_posix(),
    "sha256": hashlib.sha256(WORKFLOW_CONFIG_BYTES).hexdigest(),
}:
    raise WorkflowError("workflow attempt does not bind exact workflow config bytes")
EXECUTION_SHA256 = hashlib.sha256(
    orchestration_contracts.canonical_json_bytes(EXECUTION)
).hexdigest()
PROFILE_SHA256 = hashlib.sha256(
    orchestration_contracts.canonical_json_bytes(PROFILE)
).hexdigest()
for attempt_field, expected_value in (
    ("run_id", EXECUTION["run_id"]),
    ("execution_contract_sha256", EXECUTION_SHA256),
    ("profile_sha256", PROFILE_SHA256),
):
    if WORKFLOW_ATTEMPT[attempt_field] != expected_value:
        raise WorkflowError(
            f"workflow_attempt_path does not bind normalized {attempt_field}"
        )
if Path(WORKFLOW_ATTEMPT["source_checkout"]["path"]) != SOURCE_CHECKOUT:
    raise WorkflowError("workflow attempt does not bind configured source_checkout")
try:
    attest_source_checkout(
        root=SOURCE_CHECKOUT,
        package_root=Path(emrys.__file__).resolve().parent,
        expected_commit=WORKFLOW_ATTEMPT["source_checkout"]["commit"],
    )
except SourceCheckoutError as exc:
    raise WorkflowError(f"Could not attest workflow child source identity: {exc}") from exc
PYTHON = sys.executable
if Path(sys.executable) != CONFIGURED_PYTHON:
    raise WorkflowError("Snakemake child Python differs from configured executable")
if not CONFIGURED_PYTHON.is_file():
    raise WorkflowError("python_executable must resolve to a regular file")
if Path(WORKFLOW_ATTEMPT["normalizer"]["path"]) != CONFIGURED_PYTHON:
    raise WorkflowError("workflow attempt normalizer does not bind python_executable")
REQUIRED_TOOLS = {
    tool["name"]: Path(tool["path"]) for tool in WORKFLOW_ATTEMPT["required_tools"]
}
if (
    REQUIRED_TOOLS.get("python") != CONFIGURED_PYTHON
    or REQUIRED_TOOLS.get("snakemake") != CONFIGURED_PYTHON
):
    raise WorkflowError("workflow attempt required tools do not bind python_executable")

EXPECTED_TASKS = expected_tasks(SUCCESSOR_AUTHORITY or EXECUTION, PROFILE)
PROCESSING_SOURCE_ROOT = None
PROCESSING_OWNER_KEYS = set()
if SUCCESSOR_AUTHORITY is not None:
    plan_identity = SUCCESSOR_AUTHORITY.execution_plan.record["identity"]
    processing_source = plan_identity.get("processing_source")
    if processing_source is not None:
        PROCESSING_SOURCE_ROOT = RUN_ROOT.parent / processing_source["source_run_id"]
        PROCESSING_OWNER_KEYS = set(
            processing_stopping_owner_keys(plan_identity["functional_specification"])
        )

if SUCCESSOR_AUTHORITY is None:
    REFERENCE_ID = str(EXECUTION["reference"]["reference_id"])
    SAMPLE_IDS = tuple(str(row["sample_id"]) for row in EXECUTION["samples"]["rows"])
    COHORT_ID = str(EXECUTION["analysis"]["cohort_id"])
    PARTITION_SCOPES = tuple(
        f"{COHORT_ID}__{row['partition_id']}" for row in EXECUTION["partitions"]["rows"]
    )
    ANALYSIS_ID = str(EXECUTION["analysis"]["primary_analysis_id"])
else:
    ANALYSIS_REVISION = SUCCESSOR_AUTHORITY.analysis_revision
    ANALYSIS_IDENTITY = ANALYSIS_REVISION.record["identity"]
    REFERENCE_ID = ANALYSIS_REVISION.scope_id("reference")
    SAMPLE_IDS = tuple(str(row["sample_id"]) for row in ANALYSIS_IDENTITY["samples"])
    PARTITION_SCOPES = tuple(
        ANALYSIS_REVISION.scope_id("cohort_partition", str(row["partition_id"]))
        for row in ANALYSIS_IDENTITY["partitions"]
    )
    COHORT_ID = ANALYSIS_REVISION.scope_id("cohort")
    ANALYSIS_ID = ANALYSIS_REVISION.scope_id("analysis")

BASE_RULE_PROJECTION = dict(
    row.split()
    for row in """construct_STAR_index emrys.stage.construct_STAR_index.v1|reference|reference
convert_GTF_to_BED12 emrys.stage.convert_GTF_to_BED12.v1|reference|reference
construct_FASTA_sidecars emrys.stage.construct_FASTA_sidecars.v1|reference|reference
align_RNA_reads_with_STAR emrys.stage.align_RNA_reads_with_STAR.v1|sample|samples
construct_canonical_BAM emrys.stage.construct_canonical_BAM.v1|sample|samples
collect_canonical_BAM_QC_evidence emrys.evidence.collect_canonical_BAM_QC_evidence.v1|sample|samples
collect_RSeQC_paired_orientation_evidence emrys.evidence.collect_RSeQC_paired_orientation_evidence.v1|sample|samples
mark_BAM_duplicates_with_Picard emrys.stage.mark_BAM_duplicates_with_Picard.v1|sample|samples
split_N_cigar_reads_with_GATK emrys.stage.split_N_cigar_reads_with_GATK.v1|sample|samples
partition_BAM_by_mechanical_read_orientation emrys.stage.partition_BAM_by_mechanical_read_orientation.v1|sample|samples
generate_partitioned_cohort_mpileup_VCFs emrys.stage.generate_partitioned_cohort_mpileup_VCFs.v1|cohort_partition|partitions
preprocess_and_annotate_cohort_candidates emrys.stage.preprocess_and_annotate_cohort_candidates.v1|cohort|cohort""".splitlines()
)
FUNCTIONAL_SPECIFICATION = functional_specification_from_profile(PROFILE)
OWNER_TASKS_BY_KEY = {
    str(task["machine_key"]): task for task in PROFILE["owner_tasks"]
}
base_projection = {
    str(task["rule_name"]): "|".join(
        str(task[field]) for field in ("machine_key", "scope_type", "scope_selector")
    )
    for task in PROFILE["owner_tasks"]
    if task["rule_name"] in BASE_RULE_PROJECTION
}
if base_projection != BASE_RULE_PROJECTION:
    raise WorkflowError("Processing owner tasks do not match the static base graph")
BASE_OWNER_KEYS = {value.split("|", 1)[0] for value in BASE_RULE_PROJECTION.values()}
ANALYSIS_OWNER_KEYS = set(OWNER_TASKS_BY_KEY).difference(BASE_OWNER_KEYS)


def _owner(rule_name):
    return BASE_RULE_PROJECTION[rule_name].split("|", 1)[0]


EXPECTED_SCOPES_BY_OWNER = {}
for item in EXPECTED_TASKS:
    EXPECTED_SCOPES_BY_OWNER.setdefault(item.machine_key, set()).add(item.scope_id)

SCOPES_BY_TYPE = {
    "reference": (REFERENCE_ID,),
    "sample": SAMPLE_IDS,
    "cohort_partition": PARTITION_SCOPES,
    "cohort": (COHORT_ID,),
    "analysis": (ANALYSIS_ID,),
}
DISPATCH_PATHS = config.get("dispatch_paths")
if not isinstance(DISPATCH_PATHS, dict):
    raise WorkflowError("Workflow config 'dispatch_paths' must be an object")


if set(DISPATCH_PATHS) != set(EXPECTED_SCOPES_BY_OWNER):
    raise WorkflowError(
        "Workflow dispatch_paths owner keys do not exactly match the current plan"
    )
for machine_key, expected_scopes in EXPECTED_SCOPES_BY_OWNER.items():
    by_scope = DISPATCH_PATHS[machine_key]
    if not isinstance(by_scope, dict) or set(by_scope) != expected_scopes:
        raise WorkflowError(
            f"Dispatch scopes do not exactly match the current plan for {machine_key}"
        )

_DISPATCH_CACHE = {}


def _verified(machine_key, scope_id):
    root = (
        PROCESSING_SOURCE_ROOT
        if machine_key in PROCESSING_OWNER_KEYS
        else RUN_ROOT
    )
    return str(root / "state" / "verified" / machine_key / f"{scope_id}.json")


def _produced_verified(machine_key, scope_id):
    return str(
        RUN_ROOT / "state" / "verified" / machine_key / f"{scope_id}.json"
    )


def _dispatch_reference(machine_key, scope_id):
    cache_key = (machine_key, scope_id)
    if cache_key in _DISPATCH_CACHE:
        return _DISPATCH_CACHE[cache_key]
    by_scope = DISPATCH_PATHS.get(machine_key)
    if not isinstance(by_scope, dict):
        raise WorkflowError(f"Missing dispatch map for owner {machine_key}")
    reference = by_scope.get(scope_id)
    if not isinstance(reference, dict) or set(reference) != {"path", "sha256"}:
        raise WorkflowError(
            f"Dispatch reference must contain only path and sha256 for "
            f"{machine_key}/{scope_id}"
        )
    value = reference["path"]
    digest = reference["sha256"]
    if not isinstance(value, str) or not value:
        raise WorkflowError(f"Missing dispatch path for {machine_key}/{scope_id}")
    if not isinstance(digest, str) or re.fullmatch(r"[0-9a-f]{64}", digest) is None:
        raise WorkflowError(f"Invalid dispatch SHA-256 for {machine_key}/{scope_id}")
    path = Path(value)
    if not path.is_absolute():
        raise WorkflowError(f"Dispatch path must be absolute: {value}")
    _require_run_file(path, "dispatch record")
    payload = path.read_bytes()
    if hashlib.sha256(payload).hexdigest() != digest:
        raise WorkflowError(
            f"Dispatch bytes do not match configured SHA-256 for {machine_key}/{scope_id}"
        )
    try:
        record = orchestration_contracts.load_json_object_bytes(
            payload, f"dispatch record {path}"
        )
    except orchestration_contracts.ContractValidationError as exc:
        raise WorkflowError(f"Invalid dispatch record {path}: {exc}") from exc
    if payload != orchestration_contracts.canonical_json_bytes(record):
        raise WorkflowError(f"Dispatch must use canonical JSON bytes: {path}")
    expected = {
        "run_root": str(RUN_ROOT),
        "execution_path": str(EXECUTION_PATH),
        "profile_path": str(PROFILE_SNAPSHOT_PATH),
        "machine_key": machine_key,
        "scope": {
            "scope_type": str(OWNER_TASKS_BY_KEY[machine_key]["scope_type"]),
            "scope_id": scope_id,
        },
        "verified_task_path": _verified(machine_key, scope_id),
        "task_start_path": str(
            RUN_ROOT / "state" / "task-starts" / machine_key / f"{scope_id}.json"
        ),
    }
    for key, expected_value in expected.items():
        if record.get(key) != expected_value:
            raise WorkflowError(
                f"Dispatch {path} does not bind expected {key} for {machine_key}/{scope_id}"
            )
    dispatch_attempt_id = record.get("workflow_attempt_id")
    if not isinstance(dispatch_attempt_id, str) or re.fullmatch(
        r"workflow-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{32}", dispatch_attempt_id
    ) is None:
        raise WorkflowError(f"Dispatch {path} has an invalid workflow_attempt_id")
    task_root = (
        RUN_ROOT
        / "attempts"
        / dispatch_attempt_id
        / "tasks"
        / machine_key
        / scope_id
    )
    expected_task_paths = {
        "task_attempt_path": str(task_root / "task-attempt.json"),
        "stdout_path": str(task_root / "stdout.log"),
        "stderr_path": str(task_root / "stderr.log"),
    }
    for key, expected_value in expected_task_paths.items():
        if record.get(key) != expected_value:
            raise WorkflowError(
                f"Dispatch {path} does not bind exact {key} for {machine_key}/{scope_id}"
            )
    result = (str(path), digest, dispatch_attempt_id)
    _DISPATCH_CACHE[cache_key] = result
    return result


TASK_ARGV_PREFIX = (
    PYTHON,
    "-X",
    "pycache_prefix=/dev/null",
    "-I",
    "-m",
    "emrys.orchestration.local_pilot.task",
)
TASK_SHELL = "{params.task_argv:q}"


def _task_argv(machine_key, scope_id=None, *, wildcard=None):
    def resolve(wildcards):
        admitted_machine_key = (
            machine_key(wildcards) if callable(machine_key) else machine_key
        )
        admitted_scope = getattr(wildcards, wildcard) if wildcard else scope_id
        dispatch, digest, _attempt_id = _dispatch_reference(
            admitted_machine_key, admitted_scope
        )
        return (*TASK_ARGV_PREFIX, "--dispatch", dispatch, "--dispatch-sha256", digest)

    return resolve


def _analysis_inputs(wildcards):
    paths = []
    seen = set()
    for edge in FUNCTIONAL_SPECIFICATION["direct_edges"]:
        if str(edge["consumer"]) != str(wildcards.analysis_owner):
            continue
        producer = str(edge["producer"])
        scope_type = str(OWNER_TASKS_BY_KEY[producer]["scope_type"])
        for scope_id in SCOPES_BY_TYPE[scope_type]:
            key = producer, scope_id
            if key not in seen:
                seen.add(key)
                paths.append(_verified(*key))
    return tuple(paths)


def _admit_reusable_markers():
    blockers = verified_tree_blockers(RUN_ROOT, EXPECTED_TASKS)
    if blockers:
        raise WorkflowError(
            "Could not close verified-task state: " + "; ".join(blockers)
        )
    for item in EXPECTED_TASKS:
        machine_key, scope_id = item.machine_key, item.scope_id
        path = Path(_verified(machine_key, scope_id))
        if path.exists() or path.is_symlink():
            try:
                record = validate_verified_task(
                    path,
                    run_root=RUN_ROOT,
                    execution=EXECUTION,
                    profile=PROFILE,
                    machine_key=machine_key,
                    scope=item.scope,
                )
                expected_dispatch = _dispatch_reference(machine_key, scope_id)
                bound_dispatches = [
                    value
                    for value in record["inputs"]
                    if value["role"] == "task_dispatch"
                ]
                if len(bound_dispatches) != 1 or bound_dispatches[0] != {
                    "role": "task_dispatch",
                    "path": expected_dispatch[0],
                    "size_bytes": Path(expected_dispatch[0]).stat().st_size,
                    "sha256": expected_dispatch[1],
                }:
                    raise TaskBoundaryError(
                        "Verified task dispatch does not match current workflow config"
                    )
            except (
                OSError,
                orchestration_contracts.ContractValidationError,
                TaskBoundaryError,
            ) as exc:
                raise WorkflowError(
                    f"Could not admit reusable verified task {path}: {exc}"
                ) from exc
        elif _dispatch_reference(machine_key, scope_id)[2] != WORKFLOW_ATTEMPT_ID:
            raise WorkflowError(
                f"Pending dispatch for {machine_key}/{scope_id} does not bind "
                "the current workflow attempt"
            )


def _admit_state_namespace():
    blockers = [
        *state_tree_blockers(RUN_ROOT),
        *task_start_tree_blockers(RUN_ROOT, EXPECTED_TASKS),
    ]
    if blockers:
        raise WorkflowError("Could not close EMRYS state namespace: " + "; ".join(blockers))
    for item in EXPECTED_TASKS:
        start_path = (
            RUN_ROOT
            / "state"
            / "task-starts"
            / item.machine_key
            / f"{item.scope_id}.json"
        )
        if not start_path.exists() and not start_path.is_symlink():
            continue
        verified_path = Path(_verified(item.machine_key, item.scope_id))
        if not verified_path.exists() and not verified_path.is_symlink():
            raise WorkflowError(
                f"Task-start state is entered but incomplete: {start_path}"
            )


_admit_state_namespace()
_admit_reusable_markers()


wildcard_constraints:
    sample_id="(?:" + "|".join(re.escape(value) for value in SAMPLE_IDS) + ")",
    partition_scope="(?:" + "|".join(re.escape(value) for value in PARTITION_SCOPES) + ")",
    analysis_owner="(?:"
    + (
        "|".join(
            re.escape(value)
            for value in sorted(ANALYSIS_OWNER_KEYS & set(EXPECTED_SCOPES_BY_OWNER))
        )
        or "(?!)"
    )
    + ")"


rule reference_slice:
    input:
        _verified(_owner("construct_STAR_index"), REFERENCE_ID),
        _verified(_owner("convert_GTF_to_BED12"), REFERENCE_ID),
        _verified(_owner("construct_FASTA_sidecars"), REFERENCE_ID)


rule cohort_slice:
    input:
        tuple(_verified(item.machine_key, item.scope_id) for item in EXPECTED_TASKS)
    default_target: True


rule construct_STAR_index:
    output:
        _produced_verified(_owner("construct_STAR_index"), REFERENCE_ID)
    params:
