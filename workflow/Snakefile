"""Static local-CMH projection of NORAD's public scientific owner graph."""

from __future__ import annotations

import re
import sys
from pathlib import Path

from norad.contracts.orchestration import api as orchestration_contracts
from norad.orchestration.local_pilot.task import (
    TaskBoundaryError,
    validate_verified_task,
)


WORKFLOW_ROOT = Path(workflow.basedir).resolve()
PROFILE_PATH = (WORKFLOW_ROOT / "contracts" / "local_cmh_v1.json").resolve()
PROFILE = orchestration_contracts.load_json_object(PROFILE_PATH)
orchestration_contracts.validate_record("profile", PROFILE)
if set(config) != {"run_root", "execution_path", "profile_path", "dispatch_paths"}:
    raise WorkflowError(
        "Workflow config keys must be exactly run_root, execution_path, "
        "profile_path, and dispatch_paths"
    )


def _absolute_config_path(key):
    value = config.get(key)
    if not isinstance(value, str) or not value:
        raise WorkflowError(f"Workflow config {key!r} must be a nonempty string")
    path = Path(value)
    if not path.is_absolute():
        raise WorkflowError(f"Workflow config {key!r} must be absolute: {value}")
    return path


RUN_ROOT = _absolute_config_path("run_root")
EXECUTION_PATH = _absolute_config_path("execution_path")
PROFILE_SNAPSHOT_PATH = _absolute_config_path("profile_path")
EXECUTION = orchestration_contracts.load_json_object(EXECUTION_PATH)
orchestration_contracts.validate_record("execution", EXECUTION, profile=PROFILE)
PROFILE_SNAPSHOT = orchestration_contracts.load_json_object(PROFILE_SNAPSHOT_PATH)
if PROFILE_SNAPSHOT != PROFILE:
    raise WorkflowError("Run profile snapshot does not match the reviewed source profile")
if PROFILE_SNAPSHOT_PATH.read_bytes() != orchestration_contracts.canonical_json_bytes(
    PROFILE_SNAPSHOT
):
    raise WorkflowError("Run profile snapshot must use canonical JSON bytes")
PYTHON = sys.executable

REFERENCE_ID = EXECUTION["reference"]["reference_id"]
SAMPLE_IDS = tuple(row["sample_id"] for row in EXECUTION["samples"]["rows"])
COHORT_ID = EXECUTION["analysis"]["cohort_id"]
PARTITION_SCOPES = tuple(
    f"{COHORT_ID}__{row['partition_id']}"
    for row in EXECUTION["partitions"]["rows"]
)
ANALYSIS_ID = EXECUTION["analysis"]["primary_analysis_id"]
FIRST_SAMPLE_ID = SAMPLE_IDS[0]

OWNER_TASKS = {
    task["rule_name"]: task
    for task in PROFILE["owner_tasks"]
}
AUTOMATIC_TASKS = {
