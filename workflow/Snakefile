rule build_artifact_index:
    input:
        verified=_all_owner_outputs(),
        run_contract=str(PROJECTION_PATHS["reporting_run_contract"]),
        inventory=str(PROJECTION_PATHS["artifact_inventory"])
    output:
        str(ARTIFACT_INDEX_VERIFIED)
    params:
        python=PYTHON,
        source_checkout=str(SOURCE_CHECKOUT),
        artifact_source_root=str(ARTIFACT_SOURCE_ROOT),
        run_id=RUN_ID,
        output_root=str(ARTIFACT_OUTPUT_ROOT),
        run_root=str(RUN_ROOT),
        execution=str(EXECUTION_PATH),
        profile=str(PROFILE_SNAPSHOT_PATH),
        workflow_attempt=str(WORKFLOW_ATTEMPT_PATH),
        workflow_config=str(WORKFLOW_CONFIG_PATH),
        receipt=str(ARTIFACT_RECEIPT)
    shell:
        "{params.python:q} -X pycache_prefix=/dev/null -I -m norad build artifact-index "
        "--source-checkout {params.source_checkout:q} "
        "--artifact-source-root {params.artifact_source_root:q} "
        "--run-id {params.run_id:q} --run-contract {input.run_contract:q} "
        "--inventory {input.inventory:q} --output-root {params.output_root:q} && "
        "{params.python:q} -X pycache_prefix=/dev/null -I -m norad.orchestration.local_pilot.reporting_boundary start "
        "--kind artifact_index --run-root {params.run_root:q} "
        "--execution {params.execution:q} --profile {params.profile:q} "
        "--workflow-attempt {params.workflow_attempt:q} "
        "--workflow-config {params.workflow_config:q} && "
        "{params.python:q} -X pycache_prefix=/dev/null -I -m norad build artifact-index "
        "--source-checkout {params.source_checkout:q} "
        "--artifact-source-root {params.artifact_source_root:q} "
        "--run-id {params.run_id:q} --run-contract {input.run_contract:q} "
        "--inventory {input.inventory:q} --output-root {params.output_root:q} "
        "--execute && "
        "{params.python:q} -X pycache_prefix=/dev/null -I -m norad.orchestration.local_pilot.reporting_boundary complete "
        "--kind artifact_index --run-root {params.run_root:q} "
        "--execution {params.execution:q} --profile {params.profile:q} "
        "--workflow-attempt {params.workflow_attempt:q} "
        "--workflow-config {params.workflow_config:q} --receipt {params.receipt:q}"


