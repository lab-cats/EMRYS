orchestration_contracts.validate_record("profile", PROFILE)
CONFIG_KEYS = {
    "run_root",
    "python_executable",
    "execution_path",
    "profile_path",
    "workflow_attempt_id",
    "source_checkout",
    "artifact_source_root",
