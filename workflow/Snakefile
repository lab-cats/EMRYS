except SourceCheckoutError as exc:
    raise WorkflowError(f"Uncontrolled workflow Python runtime: {exc}") from exc


WORKFLOW_ROOT = Path(workflow.basedir).resolve()
PROFILE_PATH = (WORKFLOW_ROOT / "contracts" / "local_cmh_v2.json").resolve()
