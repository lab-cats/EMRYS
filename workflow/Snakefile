if PROFILE_SNAPSHOT != PROFILE:
    raise WorkflowError("Run profile snapshot does not match the reviewed source profile")
if PROFILE_SNAPSHOT_PATH.read_bytes() != orchestration_contracts.canonical_json_bytes(
    PROFILE_SNAPSHOT
):
    raise WorkflowError("Run profile snapshot must use canonical JSON bytes")
