rule generate_partitioned_cohort_mpileup_VCFs:
    input:
        dispatch=_partition_dispatch(AUTOMATIC_TASKS["generate_partitioned_cohort_mpileup_VCFs"][0]),
        partitioned_bams=expand(
            _sample_verified(AUTOMATIC_TASKS["partition_BAM_by_mechanical_read_orientation"][0]),
            sample_id=SAMPLE_IDS,
        ),
        reference_sidecars=_verified(AUTOMATIC_TASKS["construct_FASTA_sidecars"][0], REFERENCE_ID)
    output:
        _partition_verified(AUTOMATIC_TASKS["generate_partitioned_cohort_mpileup_VCFs"][0])
    params:
        python=PYTHON
    shell:
        "{params.python:q} -I -m norad.orchestration.local_pilot.task --dispatch {input.dispatch:q}"


rule preprocess_and_annotate_cohort_candidates:
    input:
        dispatch=_dispatch(AUTOMATIC_TASKS["preprocess_and_annotate_cohort_candidates"][0], COHORT_ID),
        partition_vcfs=expand(
