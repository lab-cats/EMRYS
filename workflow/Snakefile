rule analysis_owner:
    input:
        _analysis_inputs
    output:
        _produced_verified("{analysis_owner}", ANALYSIS_ID)
    params:
        task_argv=_task_argv(
            lambda wildcards: str(wildcards.analysis_owner), ANALYSIS_ID
        )
    threads:
        lambda wildcards: STEP_THREADS.get(
            str(OWNER_TASKS_BY_KEY[str(wildcards.analysis_owner)]["step_id"]),
            1,
        )
    resources:
        mem_mb=lambda wildcards: STAGE_MEMORY_MB[
            str(OWNER_TASKS_BY_KEY[str(wildcards.analysis_owner)]["step_id"])
        ]
    shell:
        TASK_SHELL
