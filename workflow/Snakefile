def _require_profile_projection():
    automatic_keys = {identity[0] for identity in AUTOMATIC_TASKS.values()}
    if set(PROFILE["required_owner_keys"]) != automatic_keys:
        raise WorkflowError(
            "Fixed profile required_owner_keys do not match the static automatic graph"
        )
    if set(OWNER_TASKS) != set(AUTOMATIC_TASKS):
        raise WorkflowError("Fixed profile owner task roster does not match STAGE_MAP")
    for rule_name, expected in AUTOMATIC_TASKS.items():
        task = OWNER_TASKS[rule_name]
        observed = (
            task["machine_key"],
            task["scope_type"],
            task["scope_selector"],
        )
        if observed != expected:
            raise WorkflowError(
                f"Fixed profile task {rule_name!r} does not match the static graph"
            )


_require_profile_projection()

DISPATCH_PATHS = config.get("dispatch_paths")
if not isinstance(DISPATCH_PATHS, dict):
    raise WorkflowError("Workflow config 'dispatch_paths' must be an object")


def _expected_scopes(selector):
    if selector == "reference":
        return (REFERENCE_ID,)
    if selector == "samples":
        return SAMPLE_IDS
    if selector == "partitions":
        return PARTITION_SCOPES
    if selector == "cohort":
        return (COHORT_ID,)
    if selector == "analysis":
        return (ANALYSIS_ID,)
    raise WorkflowError(f"Unsupported automatic scope selector: {selector}")


def _require_closed_dispatch_map():
    expected_owners = {
        identity[0] for identity in AUTOMATIC_TASKS.values()
    }
    if set(DISPATCH_PATHS) != expected_owners:
        raise WorkflowError(
            "Workflow dispatch_paths owner keys do not exactly match the automatic profile"
        )
    for machine_key, _, selector in AUTOMATIC_TASKS.values():
        by_scope = DISPATCH_PATHS[machine_key]
        if not isinstance(by_scope, dict) or set(by_scope) != set(
            _expected_scopes(selector)
        ):
            raise WorkflowError(
                f"Dispatch scopes do not exactly match {machine_key}/{selector}"
            )


_require_closed_dispatch_map()

_DISPATCH_CACHE = {}


def _verified(machine_key, scope_id):
    return str(RUN_ROOT / "state" / "verified" / machine_key / f"{scope_id}.json")


def _sample_verified(machine_key):
    return _verified(machine_key, "{sample_id}")


def _partition_verified(machine_key):
    return _verified(machine_key, "{partition_scope}")


def _dispatch_reference(machine_key, scope_id):
    cache_key = (machine_key, scope_id)
    if cache_key in _DISPATCH_CACHE:
        return _DISPATCH_CACHE[cache_key]
    by_scope = DISPATCH_PATHS.get(machine_key)
    if not isinstance(by_scope, dict):
        raise WorkflowError(f"Missing dispatch map for owner {machine_key}")
    reference = by_scope.get(scope_id)
    if not isinstance(reference, dict) or set(reference) != {"path", "sha256"}:
        raise WorkflowError(
            f"Dispatch reference must contain only path and sha256 for "
            f"{machine_key}/{scope_id}"
        )
    value = reference["path"]
    digest = reference["sha256"]
    if not isinstance(value, str) or not value:
        raise WorkflowError(f"Missing dispatch path for {machine_key}/{scope_id}")
    if not isinstance(digest, str) or re.fullmatch(r"[0-9a-f]{64}", digest) is None:
        raise WorkflowError(f"Invalid dispatch SHA-256 for {machine_key}/{scope_id}")
    path = Path(value)
    if not path.is_absolute():
        raise WorkflowError(f"Dispatch path must be absolute: {value}")
    _require_run_file(path, "dispatch record")
    payload = path.read_bytes()
    if hashlib.sha256(payload).hexdigest() != digest:
        raise WorkflowError(
            f"Dispatch bytes do not match configured SHA-256 for {machine_key}/{scope_id}"
        )
    try:
        record = orchestration_contracts.load_json_object_bytes(
            payload, f"dispatch record {path}"
        )
    except orchestration_contracts.ContractValidationError as exc:
        raise WorkflowError(f"Invalid dispatch record {path}: {exc}") from exc
    if payload != orchestration_contracts.canonical_json_bytes(record):
        raise WorkflowError(f"Dispatch must use canonical JSON bytes: {path}")
    expected = {
        "run_root": str(RUN_ROOT),
        "execution_path": str(EXECUTION_PATH),
        "profile_path": str(PROFILE_SNAPSHOT_PATH),
        "machine_key": machine_key,
        "scope": {
            "scope_type": next(
                scope_type
                for owner, scope_type, _ in AUTOMATIC_TASKS.values()
                if owner == machine_key
            ),
            "scope_id": scope_id,
        },
        "verified_task_path": _verified(machine_key, scope_id),
        "task_start_path": str(
            RUN_ROOT / "state" / "task-starts" / machine_key / f"{scope_id}.json"
        ),
    }
    for key, expected_value in expected.items():
        if record.get(key) != expected_value:
            raise WorkflowError(
                f"Dispatch {path} does not bind expected {key} for {machine_key}/{scope_id}"
            )
    dispatch_attempt_id = record.get("workflow_attempt_id")
    if not isinstance(dispatch_attempt_id, str) or re.fullmatch(
        r"workflow-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{32}", dispatch_attempt_id
    ) is None:
        raise WorkflowError(f"Dispatch {path} has an invalid workflow_attempt_id")
    task_root = (
        RUN_ROOT
        / "attempts"
        / dispatch_attempt_id
        / "tasks"
        / machine_key
        / scope_id
    )
    expected_task_paths = {
        "task_attempt_path": str(task_root / "task-attempt.json"),
        "stdout_path": str(task_root / "stdout.log"),
        "stderr_path": str(task_root / "stderr.log"),
    }
    for key, expected_value in expected_task_paths.items():
        if record.get(key) != expected_value:
            raise WorkflowError(
                f"Dispatch {path} does not bind exact {key} for {machine_key}/{scope_id}"
            )
    result = (str(path), digest, dispatch_attempt_id)
    _DISPATCH_CACHE[cache_key] = result
    return result


def _dispatch(machine_key, scope_id):
    return _dispatch_reference(machine_key, scope_id)[0]


def _dispatch_sha256(machine_key, scope_id):
    return _dispatch_reference(machine_key, scope_id)[1]


def _sample_dispatch(machine_key):
    return lambda wildcards: _dispatch(machine_key, wildcards.sample_id)


def _sample_dispatch_sha256(machine_key):
    return lambda wildcards: _dispatch_sha256(machine_key, wildcards.sample_id)


def _partition_dispatch(machine_key):
    return lambda wildcards: _dispatch(machine_key, wildcards.partition_scope)


def _partition_dispatch_sha256(machine_key):
    return lambda wildcards: _dispatch_sha256(machine_key, wildcards.partition_scope)


def _all_owner_outputs():
    outputs = []
    for rule_name, (machine_key, _, selector) in AUTOMATIC_TASKS.items():
        if selector == "reference":
            scopes = (REFERENCE_ID,)
        elif selector == "samples":
            scopes = SAMPLE_IDS
        elif selector == "partitions":
            scopes = PARTITION_SCOPES
        elif selector == "cohort":
            scopes = (COHORT_ID,)
        else:
            scopes = (ANALYSIS_ID,)
        outputs.extend(_verified(machine_key, scope) for scope in scopes)
    return outputs


def _admit_reusable_markers():
    verified_root = RUN_ROOT / "state" / "verified"
    expected = {
        Path(_verified(machine_key, scope_id))
        for machine_key, _, selector in AUTOMATIC_TASKS.values()
        for scope_id in _expected_scopes(selector)
    }
    if verified_root.exists() or verified_root.is_symlink():
        if verified_root.is_symlink() or not verified_root.is_dir():
            raise WorkflowError(
                f"Verified-task root must be a real directory: {verified_root}"
            )
        expected_directories = {path.parent for path in expected}
        observed_directories = set()
        observed_files = set()
        for owner_path in verified_root.iterdir():
            if owner_path.is_symlink() or not owner_path.is_dir():
                raise WorkflowError(
                    f"Unexpected verified-task root entry: {owner_path}"
                )
            observed_directories.add(owner_path)
            for marker in owner_path.iterdir():
                if marker.is_symlink() or not marker.is_file():
                    raise WorkflowError(
                        f"Unexpected verified-task owner entry: {marker}"
                    )
                observed_files.add(marker)
        if not observed_directories.issubset(expected_directories):
            unexpected = sorted(observed_directories - expected_directories)[0]
            raise WorkflowError(f"Unexpected verified-task owner directory: {unexpected}")
        if not observed_files.issubset(expected):
            unexpected = sorted(observed_files - expected)[0]
            raise WorkflowError(f"Unexpected verified-task marker: {unexpected}")
    for machine_key, scope_type, selector in AUTOMATIC_TASKS.values():
        for scope_id in _expected_scopes(selector):
            path = Path(_verified(machine_key, scope_id))
            if path.exists() or path.is_symlink():
                try:
                    record = validate_verified_task(
                        path,
                        run_root=RUN_ROOT,
                        execution=EXECUTION,
                        profile=PROFILE,
                        machine_key=machine_key,
                        scope={"scope_type": scope_type, "scope_id": scope_id},
                    )
                    expected_dispatch = _dispatch_reference(machine_key, scope_id)
                    bound_dispatches = [
                        item
                        for item in record["inputs"]
                        if item["role"] == "task_dispatch"
                    ]
                    if len(bound_dispatches) != 1 or bound_dispatches[0] != {
                        "role": "task_dispatch",
                        "path": expected_dispatch[0],
                        "size_bytes": Path(expected_dispatch[0]).stat().st_size,
                        "sha256": expected_dispatch[1],
                    }:
                        raise TaskBoundaryError(
                            "Verified task dispatch does not match current workflow config"
                        )
                except (
                    OSError,
                    orchestration_contracts.ContractValidationError,
                    TaskBoundaryError,
                ) as exc:
                    raise WorkflowError(
                        f"Could not admit reusable verified task {path}: {exc}"
                    ) from exc
            elif _dispatch_reference(machine_key, scope_id)[2] != WORKFLOW_ATTEMPT_ID:
                raise WorkflowError(
                    f"Pending dispatch for {machine_key}/{scope_id} does not bind "
                    "the current workflow attempt"
                )


def _admit_state_namespace():
    expected = expected_tasks(EXECUTION, PROFILE)
    blockers = [
        *state_tree_blockers(RUN_ROOT),
        *task_start_tree_blockers(RUN_ROOT, expected),
    ]
    if blockers:
        raise WorkflowError("Could not close NORAD state namespace: " + "; ".join(blockers))
    for item in expected:
        start_path = (
            RUN_ROOT
            / "state"
            / "task-starts"
            / item.machine_key
            / f"{item.scope_id}.json"
        )
        if not start_path.exists() and not start_path.is_symlink():
            continue
        try:
            validate_task_start(
                start_path,
                run_root=RUN_ROOT,
                execution=EXECUTION,
                profile=PROFILE,
                machine_key=item.machine_key,
                scope=item.scope,
            )
        except (OSError, TaskBoundaryError) as exc:
            raise WorkflowError(
                f"Could not admit task-start state {start_path}: {exc}"
            ) from exc
        verified_path = Path(_verified(item.machine_key, item.scope_id))
        if not verified_path.exists() and not verified_path.is_symlink():
            raise WorkflowError(
                f"Task-start state is entered but incomplete: {start_path}"
            )


_admit_state_namespace()
_admit_reusable_markers()


def _admit_reusable_reporting():
    reporting_root = RUN_ROOT / "state" / "reporting"
    if reporting_root.exists() or reporting_root.is_symlink():
        if reporting_root.is_symlink() or not reporting_root.is_dir():
            raise WorkflowError(
                f"Reporting state root must be a real directory: {reporting_root}"
            )
        for kind_path in reporting_root.iterdir():
            if (
                kind_path.name not in REPORTING_KINDS
                or kind_path.is_symlink()
                or not kind_path.is_dir()
            ):
                raise WorkflowError(
                    f"Unexpected reporting state entry: {kind_path}"
                )
            expected = {
                REPORTING_LEDGERS[kind_path.name].start,
                REPORTING_LEDGERS[kind_path.name].verified,
            }
            observed = set(kind_path.iterdir())
            unexpected = observed - expected
            if unexpected:
                raise WorkflowError(
                    "Unexpected reporting ledger entry: "
                    + str(sorted(unexpected)[0])
                )
            for entry in observed:
                if entry.is_symlink() or not entry.is_file():
                    raise WorkflowError(
                        f"Reporting ledger entry must be a real file: {entry}"
                    )
    for kind in REPORTING_KINDS:
        paths = REPORTING_LEDGERS[kind]
        has_start = paths.start.exists() or paths.start.is_symlink()
        has_verified = paths.verified.exists() or paths.verified.is_symlink()
        if has_start != has_verified:
            state = "entered but incomplete" if has_start else "orphan completion"
            raise WorkflowError(f"Reporting ledger {kind} is {state}")
        if has_verified:
            try:
                validate_verified(kind, RUN_ROOT, EXECUTION, PROFILE)
            except (OSError, ReportingBoundaryError) as exc:
                raise WorkflowError(
                    f"Could not admit reusable {kind} reporting ledger: {exc}"
                ) from exc


_admit_reusable_reporting()


wildcard_constraints:
    sample_id="(?:" + "|".join(re.escape(value) for value in SAMPLE_IDS) + ")",
    partition_scope="(?:" + "|".join(re.escape(value) for value in PARTITION_SCOPES) + ")"


